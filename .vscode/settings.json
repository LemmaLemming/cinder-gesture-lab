{
  "godotTools.lsp.headless": false,
  "godotTools.lsp.serverHost": "127.0.0.1",
  "godotTools.lsp.serverPort": 6005,
  "files.exclude": {
    "**/.godot": true,
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/.godot/**": true,
    "**/.tools/**": true,
    "**/exports/**": true,
    "**/captures/**": true
  },
  "search.exclude": {
    "**/.godot": true,
    "**/.tools": true,
    "**/exports": true,
    "**/captures": true
  },
  "[gdscript]": {
    "editor.insertSpaces": false,
    "editor.tabSize": 4,
    "editor.formatOnSave": false
  }
}
