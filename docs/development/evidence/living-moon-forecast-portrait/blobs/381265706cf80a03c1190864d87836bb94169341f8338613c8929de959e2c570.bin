  "scope": "Explicit finite custody cohort for this focused component, not a claim of every transitive runtime resource. Root may include its existing canonical capture dependencies; do not repin historical evidence or require a whole HEAD match.",
  "promotion": [
    {
      "from": ".cinder/l5-presentation-forecast-repair-20261016/living_moon.gd.txt",
      "to": "scripts/acts/act1/living_moon.gd",
      "sha256": "d25ae002a4d6256fd95b3e6df557541de1cd4ac4503cc7fde3dd50d52b0d4808",
      "old_sha256": "9056b2111d3e709fca592a38ac58ad1a181a0b1825128493fde7a180c71b9144"
    },
    {
      "from": ".cinder/l5-presentation-forecast-repair-20261016/a1_l5_forecast_publication.report-safe.gd.txt",
      "to": "tests/act1_l5_forecast_publication.gd",
      "sha256": "65f085df2ef263ecce7816149ce2e144abe98fb1b3d6ee35392ce221a2284e41",
      "expected_target_before_promotion": "ABSENT; Root must verify, never overwrite unrelated source",
      "uid": "No new UID fabricated. Direct --script path loading does not itself require a UID; Root verifies actual native dependency state."
    }
  ],
  "command": {
    "cwd": "/Users/howardchen/Documents/ChatGPT/video game idea",
    "argv": [
      "python3",
      "scripts/dev/dev.py",
      "engine",
      "--headless",
      "--path",
      "/Users/howardchen/Documents/ChatGPT/video game idea",
      "--script",
      "tests/act1_l5_forecast_publication.gd",
      "--",
      "--forecast-publication"
    ],
    "env": {
      "CINDER_A1_L5_FORECAST_REPORT": "<fresh absolute Root phase directory>/native-report.json"
    },
    "engine_runs": 1,
    "fixture_wall_watchdog_ms": 120000,
    "recommended_owned_child_timeout_s": 180,
    "queue": "Canonical dev.py engine acquires shared Godot lock; Root alone launches. No lock removal/process interference.",
    "separate_import": "Not requested; only if genuine new-UID/dependency condition is demonstrated."
  },
  "closure_contract": {
    "report_kind": "a1-l5-forecast-publication-regression-1",
    "literal_footer_regex": "^A1-L5 FORECAST: ([0-9]+) checks, ([0-9]+) failures; complete=(true|false)$",
    "rows": "Consecutive actual 1..checks; each has check,label,note,ok. Count actual false rows equals failures. first_failure literal inherited dictionary or {}.",
    "checks": "No invented expected pass count. Actual closed report/footer/raw/child return and diagnostic scan determine outcome.",
    "success": "actual complete=true, success=true, failures=0, child0, raw clean and all named source/UID custody before/at lock/after/close unchanged from promoted manifest. Retain failed/incomplete/partial artifacts.",
    "artifacts": [
      "native-report.json",
      "native-before.var",
      "after-hard.var",
      "during-soft.var",
      "after-soft.var",
      "after-invalid.var",
      "native-store/ actual files",
      "actual raw stdout/stderr",
      "actual command/queue metadata",
      "source/UID captures and hashes"
    ],
    "artifact_limits": "Witnesses exist only if reached; never reconstruct or invent missing witnesses. Native typed wires are original var_to_bytes; report diagnostics use closed JSON. No graphic response or new native gameplay proof claimed."
  }
}
