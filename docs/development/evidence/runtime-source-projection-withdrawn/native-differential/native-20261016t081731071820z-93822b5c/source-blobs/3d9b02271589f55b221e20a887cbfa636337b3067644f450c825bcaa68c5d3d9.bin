+## Same-call pure projection for Scheduler's fresh exact-native source reader.
+## This is not a validation receipt or native authority. Subclasses keep state().
+func _authored_source_guard_identity() -> Dictionary:
+	if get_script() != CinderReplayProgram or _reader == null or _reader.get_script() != Authored:
+		return state()
+	return _reader._source_guard_identity()
+
+
 func state() -> Dictionary:
 	return {} if _reader == null else _reader.state()
 
