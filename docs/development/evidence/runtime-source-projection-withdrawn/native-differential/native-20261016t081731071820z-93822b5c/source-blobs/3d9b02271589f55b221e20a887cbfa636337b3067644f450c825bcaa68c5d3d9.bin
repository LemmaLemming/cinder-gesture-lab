+
+## Pure two-field projection; validation and native getter order stay at callers.
+## The source guard owns this exact reader and no caller can mutate its _json.
+func _source_guard_identity() -> Dictionary:
+	if get_script() != CinderAuthoredEnemySequence or _json.is_empty():
+		return state()
+	return {"source_id": _json.source_id, "authored": {"tether_position": Codec.read_vector3(_json.authored.tether_position)}}
 
 
