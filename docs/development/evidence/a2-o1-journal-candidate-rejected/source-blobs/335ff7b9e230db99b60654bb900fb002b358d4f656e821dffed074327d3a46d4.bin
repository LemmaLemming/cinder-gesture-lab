  "expected_runtime": "All listed canonical inputs remain current; ORIGINAL host2c9768f8/kit0676ebcb/Scoutdee72b85/Exchange6d8e11a2. No reader/runtime/layout promotion before actual producer closure and sealed artifact review. No whole-HEAD match required. This is an explicit finite primary cohort, not a transitive resource census.",
  "execution_source": {
    "source": ".cinder/a2-o1-difficulty-20261016/producer-prepare/a2_o1_original_challenge_writer.gd.txt",
    "root_only_copy_to": ".cinder/a2-o1-difficulty-20261016/producer-prepare/a2_o1_original_challenge_writer.gd",
    "sha256": "4ea8811162217e31df3414c051029afe3fc4550f898e98de16c7bf48d8ba7dba",
    "new_uid": "ABSENT and not invented; explicit --script path may load directly. No separate import requested absent actual dependency."
  },
  "command": {
    "cwd": "/Users/howardchen/Documents/ChatGPT/video game idea",
    "argv": [
      "python3",
      "scripts/dev/dev.py",
      "engine",
      "--headless",
      "--path",
      "/Users/howardchen/Documents/ChatGPT/video game idea",
      "--script",
      "res://.cinder/a2-o1-difficulty-20261016/producer-prepare/a2_o1_original_challenge_writer.gd",
      "--",
      "--original-challenge-writer"
    ],
    "environment": {
      "CINDER_A2_O1_ORIGINAL_WRITER_REPORT": "<fresh absolute Root phase directory>/native-report.json"
    },
    "queue": "Canonical dev.py shared Godot lock. Root sole engine owner; capture custody before queue/at actual lock/after/close. Never bypass/delete lock or interfere with another process.",
    "runs": 1,
    "fixture_wall_watchdog_ms": 120000,
    "owned_child_timeout_s": 180,
    "no_additional_phases": "No engine executed by this task. No full prefix/route/all-kill/all-kit/current reader/parent suite/import phase requested."
  },
  "actual_report_contract": {
    "kind": "a2-o1-original-challenge-writer-1",
    "footer_regex": "^A2-O1 ORIGINAL WRITER: ([0-9]+) checks, ([0-9]+) failures; complete=(true|false)$",
    "rows": "Literal consecutive 1..checks with check/label/note/ok, actual false count=failures; actual first_failure plus first_native_refusal. No invented expected count.",
    "closure": "Actual complete/success true, failures0, child0 and diagnostic-clean raw plus exact per-path custody required to call this producer closed clean. Otherwise preserve partial raw/units/first refusal; do not repair missing units or relabel failure.",
    "native_artifacts": [
      "units/entrance/{whole,checkpoint,story,attempts}.exact.json",
      "units/before-final/{whole,checkpoint,story,attempts}.exact.json",
      "units/held-final-warning/{whole,checkpoint,story,attempts}.exact.json",
      "each reached units/<label>/whole-native.var",
      "each reached units/<label>/raw-campaign.json and raw-campaign.json.bak",
      "each reached units/<label>/raw-preferences.json; other settings/preferences backups only if genuinely present",
      "actual native source user:// files left intact",
      "native-report.json",
      "raw stdout/stderr/command/queue/index/source-UID custody"
    ],
    "copy_rule": "Exact original bytes only, fresh destinations, original user/absolute/destination path+SHA+byte size/presence map. No schema rewriting, pose/clock/HP/collected/checkpoint repair, historical source repin or reconstruction of missing artifacts."
  },
  "setup_and_limits": {
    "test_setup": "Inherited accepted Root registration _seed_story: actual pristine A2-L2 Main/Hero/level snapshot + explicit TEST predecessor PREFIX. Public Continue and Optional signals, no GUI or earned prefix credit. Canonical accepted Registry unmodified.",
    "equipment": "Existing baseline CLOTH-J0/P0/S0/WEAPON-01, no new type/perk/pickup/reward/stat change. Live canonical queries actual0/empty stderr retained; no claim/reservation made.",
    "route": "Exactly four fixed public Player.request_dash calls: left-forward diagonal, forward, forward, right-forward diagonal. Native readiness/cooldown/full stop and actual world-action landing observed. No direction search, forced actor/lease/phase/clock or full route. Native before-final checkpoint does not require first two journals; current sample may retain none collected.",
    "stop": "First explicitly observed native admission/runtime refusal/cancellation or refused public dash stops incomplete; passive native transition receipt retains cancellation before a later native retry could overwrite it. No retry loop or forced final activation.",
    "scope": "Original writer only. No new layout/meaningful decision/combat response/collection-completion/GUI/art/current reader/Continue-Retry acceptance credit. Actual reached old whole units provide later separate reader inputs."
  }
}
