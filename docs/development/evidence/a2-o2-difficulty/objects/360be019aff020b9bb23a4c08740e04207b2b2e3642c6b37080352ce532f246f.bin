"""Root-only seal then one original-first/candidate-second A2-O2 Handler response pair."""
from pathlib import Path
import argparse
import contextlib
import datetime
import importlib.util
import json
import os
import re
import signal
import stat
import sys
import types
import uuid

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
# Execute the pinned helper source directly, avoiding an unpinned .pyc cache.
check = types.ModuleType("cinder_o2_handler_native_inspect")
exec(compile((HERE / "native_inspect.py").read_bytes(), str(HERE / "native_inspect.py"), "exec"), check.__dict__)
DIAGNOSTIC = re.compile(r"^\s*(?:ERROR|WARNING|SCRIPT ERROR):|ObjectDB.*leak|Orphan.*StringName", re.I)


def save(path, value):
    data = (json.dumps(value, indent=2, allow_nan=False) + "\n").encode()
    temporary = path.with_name(path.name + ".tmp")
    with temporary.open("xb") as stream:
        stream.write(data); stream.flush(); os.fsync(stream.fileno())
    os.replace(temporary, path)


def record(path):
    present = os.path.lexists(path)
    st = path.lstat() if present else None
    regular = bool(st and stat.S_ISREG(st.st_mode))
    data = check.stable(path)[1] if regular else None
    return {"exists": present, "regular": regular, "symlink": bool(st and stat.S_ISLNK(st.st_mode)),
            "sha256": check.digest(data) if data is not None else None, "bytes": len(data) if data is not None else None,
            "mode": format(stat.S_IMODE(st.st_mode), "04o") if st else None}, data


def engine(spec):
    path = Path(spec["engine_expected"]["path"])
    row, _ = record(path)
    check.require(row == spec["engine_expected"]["record"] and os.access(path, os.X_OK), "Exact existing engine bytes/size/mode/type differ")
    return dict(row, path=str(path), retained_binary=False)


def snapshot(spec, out, label, variant="original"):
    names = sorted(set(spec["expected"]) | set(spec["self_files"]))
    rows = {}; retained = {}; blobs = out / "source-blobs"; blobs.mkdir(exist_ok=True)
    for name in names:
        row, data = record(ROOT / name); rows[name] = row
        if data is not None:
            target = blobs / (row["sha256"] + ".bin")
            if not target.exists():
                with target.open("xb") as stream: stream.write(data)
            check.require(check.digest(target.read_bytes()) == row["sha256"], "Retained source CAS differs")
            retained[name] = dict(row, blob=str(target.relative_to(out)))
    save(out / (label + ".json"), rows); save(out / (label + "-retention.json"), retained)
    expected_inputs = dict(spec["expected"])
    expected_inputs[spec["subject"]] = spec["subject_variants"][variant]
    for name, expected in expected_inputs.items():
        check.require(rows[name] == expected, "Fixed named source/size/mode/absence/type differs: " + name)
    readiness = check.strict((HERE / "READINESS.json").read_bytes())
    for name in spec["self_files"]:
        check.require(rows[name]["regular"] and not rows[name]["symlink"] and rows[name]["mode"] == "0644", "Regular0644 host input required")
    for name, expected in readiness["frozen_files"].items():
        check.require(rows[name]["sha256"] == expected, "Frozen host control changed: " + name)
    return rows


def old_seal(path):
    check.require(path.name == "seal.json" and path.parent.parent == HERE, "Closed seal from this exact capsule required")
    result = check.strict((path.parent / "result.json").read_bytes()); index = check.strict((path.parent / "evidence-index.json").read_bytes())
    check.require(result.get("closed") is True and result.get("passed") is True and type(result.get("host_return")) is int
                  and result["host_return"] == 0 and index.get("created_after_raw_close") is True, "Seal must have genuinely closed0")
    for name in ["seal.json", "result.json"]:
        meta, _ = check.stable(path.parent / name)
        check.require(index["files"][name] == {k:meta[k] for k in ["sha256", "bytes", "mode"]}, "Seal/index metadata differs")
    seal = check.strict(path.read_bytes())
    check.require(seal.get("sealed") is True and seal.get("source_phase") == str(path.parent), "Actual seal identity differs")
    return seal["sources"]


class Tee:
    def __init__(self, terminal, log): self.terminal, self.log = terminal, log
    def write(self, value): self.log.write(value); return self.terminal.write(value)
    def flush(self): self.log.flush(); self.terminal.flush()


def retain_observed(out, observation):
    records = []; destination = out / "native-retained-blobs"; destination.mkdir(exist_ok=True)
    for row in observation.get("retained", []):
        meta, data = check.stable(Path(row["path"]))
        check.require(meta == row, "Native original drift before retention")
        target = destination / (meta["sha256"] + ".bin")
        if not target.exists():
            with target.open("xb") as stream: stream.write(data)
        check.require(check.digest(target.read_bytes()) == meta["sha256"], "Native retained CAS differs")
        records.append(dict(meta, retained_blob=str(target.relative_to(out))))
    save(out / "native-literal-retention.json", records)


require = check.require
file_record = record

def replace_subject(path, data, mode, expected_prior):
    require(expected_prior["regular"] and not expected_prior["symlink"], "Expected prior subject must be a regular non-symlink")
    temporary = path.with_name(path.name + ".binding-tail-owned-" + uuid.uuid4().hex + ".tmp")
    try:
        with temporary.open("xb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, int(mode, 8))
        # Recheck exact prior bytes/size/mode/type AFTER the replacement is ready,
        # immediately before replace, for both selection and restoration. The
        # cooperating canonical lock cannot remove an uncooperative OS TOCTOU.
        require(file_record(path)[0] == expected_prior, "Subject prior bytes/size/mode/type changed; left in situ")
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def retain_unexpected_subject(path, out, label):
    record, data = file_record(path)
    if data is not None:
        with (out / (label + ".bin")).open("xb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
    metadata = dict(record, subject=str(path), left_in_situ=True)
    if record["symlink"]:
        metadata["link_target"] = os.readlink(path)  # Never read the foreign target.
    save(out / (label + ".json"), metadata)
    return record


def restore_subject_if_known(path, original, original_record, candidate_record, out,
                             owned_children_closed, swap_attempted):
    receipt = {"restored_exact_bytes_and_mode": False, "swap_attempted": swap_attempted,
               "under_canonical_lock": True, "owned_children_closed": owned_children_closed,
               "subject_write_attempted": False, "unknown_subject_overwrite_authorized": False}
    if not owned_children_closed:
        receipt.update(status="FAILED_OWNED_CHILD_STILL_OPEN_NO_WRITE", restored=file_record(path)[0])
    else:
        current = file_record(path)[0]
        if current == original_record:
            # Covers an interruption before atomic swap; do not misclassify an
            # unchanged original as a foreign edit or rewrite it needlessly.
            receipt.update(status="ALREADY_EXACT_ORIGINAL_NO_WRITE", restored=current,
                           restored_exact_bytes_and_mode=True)
        elif current == candidate_record:
            receipt["subject_write_attempted"] = True
            try:
                replace_subject(path, original, original_record["mode"], candidate_record)
                restored = file_record(path)[0]
                receipt.update(status="RESTORED_KNOWN_CANDIDATE" if restored == original_record else "FAILED_POST_RESTORE_DRIFT",
                               restored=restored, restored_exact_bytes_and_mode=restored == original_record)
                if restored != original_record:
                    retain_unexpected_subject(path, out, "unexpected-subject-after-restore")
            except Exception as error:
                # A final-guard conflict is left untouched, including mode/type.
                receipt.update(status="FAILED_GUARDED_RESTORE_NO_UNKNOWN_WRITE", error=str(error),
                               restored=retain_unexpected_subject(path, out, "unexpected-subject-at-restore-guard"))
        else:
            receipt.update(status="FAILED_UNKNOWN_SUBJECT_LEFT_IN_SITU",
                           restored=retain_unexpected_subject(path, out, "unexpected-subject-before-restore"))
    save(out / "restore-receipt.json", receipt)
    return receipt


def indexed(out):
    files = {}
    for path in sorted(out.rglob("*")):
        if path.is_file() and path != out / "evidence-index.json":
            row, _ = check.stable(path)
            files[str(path.relative_to(out))] = {k:row[k] for k in ["sha256", "bytes", "mode"]}
    save(out / "evidence-index.json", {"created_after_raw_close": True, "files": files})


def execute_phase(dev, spec, parent, variant, context, lock_fd, registry, baseline=None):
    out = parent / variant; out.mkdir(exist_ok=False)
    result = {"phase": variant, "closed": False, "passed": False, "engine_launch_attempted": False,
              "native_functional_pass": False, "canonical_api_return": None, "owned_children": []}
    code = 2; interrupted = False
    with (out / "raw.log").open("x") as raw, contextlib.redirect_stdout(Tee(sys.stdout, raw)), contextlib.redirect_stderr(Tee(sys.stderr, raw)):
        try:
            snapshot(spec, out, "sources-at-lock", variant)
            before = engine(spec); save(out / "engine-before.json", before)
            evidence = out / "evidence"; evidence.mkdir(exist_ok=False)
            report = evidence / "native-report.json"
            args = ["--cell=" + variant]
            if baseline is not None:
                original, _ = check.stable(Path(baseline["path"]))
                check.require(original["sha256"] == baseline["sha256"], "Closed original unit drift before candidate")
                args += ["--baseline=" + baseline["path"], "--baseline-sha256=" + baseline["sha256"]]
            child_env = dict(context.environ)
            child_env["CINDER_A2_O2_HANDLER_COMPARE_REPORT"] = str(report)
            child_context = dev.ProjectContext(root=ROOT, environ=child_env)
            command = [spec["engine_expected"]["path"], "--path", str(ROOT), "--headless", "--log-file", str(out / "engine.log"),
                       "--script", "res://" + spec["fixture"], "--"] + args
            save(out / "command.json", {"argv": command, "user_arguments": args, "report_environment": {"CINDER_A2_O2_HANDLER_COMPARE_REPORT": str(report)}, "timeout_after_lock_seconds": 180,
                                       "canonical_api": "dev.godot_lock/run_validation", "one_owned_child": True, "variant": variant})
            owned = []; actual_popen = dev.subprocess.Popen
            def tracked(argv, *pos, **kw):
                check.require(argv == command and not owned and kw.get("cwd") == ROOT and kw.get("env") == child_context.environ
                              and kw.get("pass_fds") == (lock_fd,), "Exactly one planned canonical child/context/lock required")
                child = actual_popen(argv, *pos, **kw); owned.append(child); registry.append(child); return child
            result["engine_launch_attempted"] = True; save(out / "result.json", result)
            try:
                dev.subprocess.Popen = tracked
                result["canonical_api_return"] = dev.run_validation(command, child_context, lock_fd, 180, detect_godot_errors=True)
            finally:
                dev.subprocess.Popen = actual_popen
                for child in owned:
                    if child.poll() is None: dev.stop_validation(child)
                    child.wait(timeout=5)
                result["owned_children"] = [{"pid":child.pid,"closed":child.poll() is not None,"popen_return":child.poll()} for child in owned]
                save(out / "result.json", result)
            check.require(len(owned) == 1 and owned[0].poll() is not None, "Actual own child must close before any source write")
            raw.flush()
            observation = check.observe(out, ROOT, spec, variant, (out / "raw.log").read_text(),
                                        result["canonical_api_return"], owned[0].poll(), baseline)
            result["native_observation"] = observation; save(out / "native-observation.json", observation)
            retain_observed(out, observation)
            snapshot(spec, out, "sources-after-child", variant)
            after = engine(spec); save(out / "engine-after.json", after); check.require(after == before, "Engine identity drift")
            result["native_functional_pass"] = observation["functional_pass"]
            check.require(observation["functional_pass"], "Actual native rows/report/artifact/footer/API/Popen failed or incomplete")
            engine_raw = (out / "engine.log").read_text(errors="replace") if (out / "engine.log").is_file() else ""
            check.require(not any(DIAGNOSTIC.search(line) for line in ((out / "raw.log").read_text()+"\n"+engine_raw).splitlines()),
                          "Actual diagnostic remains NONCLEAN; no retry or candidate after unsuccessful original")
            result["passed"] = True; code = 0
        except KeyboardInterrupt:
            result["error"] = "Interrupted; canonical API closes only its actual owned child"; interrupted = True; code = 130
        except Exception as error:
            result["error"] = str(error); print("A2-O2 Handler comparison phase failure:", error, flush=True)
        finally:
            try:
                snapshot(spec, out, "sources-at-phase-close", variant); save(out / "engine-at-close.json", engine(spec))
            except Exception as error:
                result["close_custody_error"] = str(error); result["passed"] = False; code = 2
            raw.flush(); result.update(closed=True, host_return=code,
                raw_diagnostics=[line for line in (out / "raw.log").read_text().splitlines() if DIAGNOSTIC.search(line)])
            save(out / "result.json", result)
            print("A2-O2 Handler comparison phase CLOSED " + variant + " code=" + str(code), flush=True)
    indexed(out)
    if interrupted: raise KeyboardInterrupt()
    return result


def closed_original_baseline(out, phase, spec):
    # The native unit is a baseline only after all external closure evidence is
    # stable and joined. No JSON/Variant decoding manufactures native authority.
    result_meta, result_bytes = check.stable(out / "result.json")
    result = check.strict(result_bytes)
    index_meta, index_bytes = check.stable(out / "evidence-index.json")
    index = check.strict(index_bytes)
    check.require(result == phase and result.get("phase") == "original"
                  and result.get("closed") is True and result.get("passed") is True
                  and type(result.get("host_return")) is int and result["host_return"] == 0
                  and type(result.get("canonical_api_return")) is int and result["canonical_api_return"] == 0
                  and result.get("native_functional_pass") is True and result.get("raw_diagnostics") == []
                  and type(result.get("owned_children")) is list and len(result["owned_children"]) == 1
                  and result["owned_children"][0].get("closed") is True
                  and type(result["owned_children"][0].get("popen_return")) is int
                  and result["owned_children"][0]["popen_return"] == 0,
                  "Original baseline requires actual successful clean Host/API/owned-child closure")
    check.require(type(index) is dict and index.get("created_after_raw_close") is True
                  and type(index.get("files")) is dict, "Original closed evidence index required")
    required = {"result.json", "raw.log", "engine.log", "command.json", "native-observation.json",
                "native-literal-retention.json", "engine-before.json", "engine-after.json", "engine-at-close.json",
                "sources-at-lock.json", "sources-after-child.json", "sources-at-phase-close.json",
                "sources-at-lock-retention.json", "sources-after-child-retention.json", "sources-at-phase-close-retention.json",
                "evidence/native-report.json", "evidence/comparison-unit.json"}
    check.require(required <= set(index["files"]), "Original index omitted an external authority member")
    for name, expected in index["files"].items():
        relative = Path(name)
        check.require(not relative.is_absolute() and ".." not in relative.parts, "Literal relative index path required")
        meta, _ = check.stable(out / relative)
        check.require(expected == {key: meta[key] for key in ["sha256", "bytes", "mode"]}, "Original indexed evidence changed: " + name)
    raw_meta, raw_bytes = check.stable(out / "raw.log")
    _, engine_bytes = check.stable(out / "engine.log")
    check.require(not any(DIAGNOSTIC.search(line) for line in (raw_bytes + b"\n" + engine_bytes).decode(errors="replace").splitlines()),
                  "Original raw/engine diagnostic remains nonclean")
    observed = check.observe(out, ROOT, spec, "original", raw_bytes.decode(), 0, 0)
    check.require(observed.get("functional_pass") is True and observed == result["native_observation"], "Original literal report/raw/footer/source/unit closure join differs")
    states = [check.strict((out / name).read_bytes()) for name in ["sources-at-lock.json", "sources-after-child.json", "sources-at-phase-close.json"]]
    check.require(states[0] == states[1] == states[2], "Original source custody changed across native child")
    expected_sources = dict(spec["expected"])
    expected_sources[spec["subject"]] = spec["subject_variants"]["original"]
    for name, expected in expected_sources.items():
        check.require(states[0].get(name) == expected, "Original source map differs from selected fixed input: " + name)
    _, result_after = check.stable(out / "result.json")
    _, index_after = check.stable(out / "evidence-index.json")
    check.require(result_bytes == result_after and index_bytes == index_after, "Original closure files drifted during baseline selection")
    return observed["comparison_unit"]


def main():
    parser = argparse.ArgumentParser(description=__doc__); parser.add_argument("phase", choices=["seal", "pair"]); parser.add_argument("--seal", type=Path)
    args = parser.parse_args(); stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    out = HERE / ("run-"+args.phase+"-"+stamp+"-"+uuid.uuid4().hex[:8]); out.mkdir(exist_ok=False)
    result = {"phase":args.phase,"closed":False,"passed":False,"candidate_accepted":False,"phases":[]}
    queue = {"queued":False,"acquired":False,"lock_context_released":False}; spec = None; sealed = None; code = 2
    old_term = signal.getsignal(signal.SIGTERM); signal.signal(signal.SIGTERM,lambda _sig,_frame:(_ for _ in ()).throw(KeyboardInterrupt()))
    with (out / "raw.log").open("x") as raw, contextlib.redirect_stdout(Tee(sys.stdout,raw)), contextlib.redirect_stderr(Tee(sys.stderr,raw)):
        try:
            check.require((args.phase=="seal")==(args.seal is None), "Pair needs exact closed seal; seal takes none")
            spec = check.strict((HERE / "INPUT_SPEC.json").read_bytes()); check.require(spec["integration_root"]==str(ROOT), "Exact flat Integration host required")
            before = engine(spec); save(out / "engine-before.json",before)
            current = snapshot(spec,out,"preflight-observed")
            if args.phase=="seal":
                sealed = snapshot(spec,out,"sources-at-seal"); check.require(current==sealed,"Source drift during host-only seal")
                save(out / "seal.json",{"sealed":True,"source_phase":str(out),"sources":sealed,"scope":spec["scope"]})
            else:
                selected = args.seal.absolute(); sealed = old_seal(selected); check.require(current==sealed,"Sources differ from selected closed seal")
                save(out / "selected-seal.json",{"path":str(selected),"sha256":check.digest(selected.read_bytes())})
                module = importlib.util.spec_from_file_location("cinder_a2_o2_pair_dev",ROOT / "scripts/dev/dev.py")
                check.require(module is not None and module.loader is not None,"Actual canonical dev module required")
                dev = importlib.util.module_from_spec(module); sys.modules[module.name]=dev
                prior_bytecode=sys.dont_write_bytecode
                try: sys.dont_write_bytecode=True; module.loader.exec_module(dev)
                finally: sys.dont_write_bytecode=prior_bytecode
                env=dict(os.environ); env.update(CINDER_GODOT=spec["engine_expected"]["path"],CINDER_CANONICAL_ROOT=str(ROOT),PYTHONDONTWRITEBYTECODE="1")
                context=dev.ProjectContext(root=ROOT,environ=env)
                check.require(context.root==ROOT and context.canonical_root==ROOT and str(dev.resolve_godot(context))==spec["engine_expected"]["path"],"Canonical context/engine differs")
                check.require(snapshot(spec,out,"sources-before-queue")==sealed,"Inputs changed before queue")
                original=(ROOT / spec["original_source"]).read_bytes()
                check.require(check.digest(original)==spec["subject_variants"]["original"]["sha256"],"Immutable original restoration bytes required")
                queue.update(queued=True,lock_path=str(dev.shared_lock_path(ROOT))); save(out / "queue.json",queue)
                registry=[]; swap_attempted=False
                try:
                    with dev.godot_lock(ROOT) as lock_fd:
                        queue["acquired"]=True; save(out / "queue.json",queue)
                        try:
                            check.require(snapshot(spec,out,"sources-at-lock")==sealed and engine(spec)==before,"Exact original inputs/engine at lock required")
                            subject=ROOT / spec["subject"]; original_record,beforeimage=record(subject)
                            check.require(original_record==spec["subject_variants"]["original"] and beforeimage==original,"Exact original beforeimage required")
                            with (out / "original-subject-beforeimage.bin").open("xb") as stream: stream.write(original); stream.flush(); os.fsync(stream.fileno())
                            save(out / "subject-beforeimage.json",dict(original_record,path=str(subject),scope="Durable original bytes/mode; no write before own child closure"))
                            first=execute_phase(dev,spec,out,"original",context,lock_fd,registry); result["phases"].append(first)
                            check.require(first["passed"] is True and first["closed"] is True,"Original must close successful/clean before candidate; stop without replacement")
                            check.require(all(child.poll() is not None for child in registry),"Original actual owned child must close before source replacement")
                            baseline=closed_original_baseline(out / "original", first, spec)
                            snapshot(spec,out,"sources-before-candidate-selection")
                            candidate_meta,candidate=record(ROOT / spec["candidate_source"])
                            check.require(candidate_meta==spec["expected"][spec["candidate_source"]],"Exact selected private candidate bytes/size/mode/type required")
                            swap_attempted=True
                            replace_subject(subject,candidate,spec["subject_variants"]["candidate"]["mode"],spec["subject_variants"]["original"])
                            snapshot(spec,out,"sources-candidate-selected","candidate")
                            second=execute_phase(dev,spec,out,"candidate",context,lock_fd,registry,baseline); result["phases"].append(second)
                            check.require(second["passed"] is True and second["closed"] is True,"Candidate actual response failed/incomplete; no repetition")
                            result["fixed_experiment_observations"]={"original":first["native_observation"]["summary"],"candidate":second["native_observation"]["summary"],
                                "scope":"Two actual native source-scoped responses and native recorded old-path counterfactual against matched candidate held union, with original literal Exact artifacts retained opaque. Not host geometry/Variant reproof, campaign/fullroute/legacy transport/balance/portrait/performance or difficulty acceptance."}
                        finally:
                            # Candidate selection never licenses clobbering unknown edits.
                            receipt=restore_subject_if_known(ROOT / spec["subject"],original,spec["subject_variants"]["original"],
                                spec["subject_variants"]["candidate"],out,all(child.poll() is not None for child in registry),swap_attempted)
                            check.require(receipt["restored_exact_bytes_and_mode"],"Known original restoration failed; unknown source left in situ")
                            snapshot(spec,out,"sources-after-restore")
                finally:
                    if queue["acquired"]: queue["lock_context_released"]=True; save(out / "queue.json",queue)
            result["passed"]=True; code=0
        except KeyboardInterrupt:
            result["error"]="Interrupted; only owned child cleanup and guarded known-source restoration permitted"; code=130
        except Exception as error:
            result["error"]=str(error); print("A2-O2 Handler comparison host failure:",error,flush=True)
        finally:
            if spec is not None:
                try:
                    snapshot(spec,out,"sources-at-runner-close"); save(out / "engine-after.json",engine(spec))
                except Exception as error:
                    result["close_custody_error"]=str(error); result["passed"]=False; code=2
            raw.flush(); result.update(closed=True,host_return=code,
                scope="One original-first/candidate-second pair only; native/API/ownedPopen/Host diagnostics distinct. No automatic candidate/policy acceptance or new level gate.")
            save(out / "result.json",result); save(out / "queue.json",queue)
            print("A2-O2 Handler comparison host CLOSED code="+str(code),flush=True)
    signal.signal(signal.SIGTERM,old_term); indexed(out); return code


if __name__=="__main__": raise SystemExit(main())

