extends "res://tests/acts/act3/crystalman_rule_room_smoke.gd"
## PRIVATE / UNEXECUTED. Literal original API2 units, not reconstructed legacy.
## Native phase-only TEST recipient under original declared parent floor. No
## whole-parent optical/campaign/history credit. Candidate cohort required.
const Phase = preload("res://scripts/acts/act3/crystalman_capture_phase.gd")
const ProfileMain = preload("res://tests/fixtures/captured_policy_profile_main.gd")
const Store = preload("res://scripts/campaign/save_store.gd")
const PARENT: String = "res://tests/acts/act3/fixtures/crystalman_declared_2.tscn"
const FIXTURES: String = "res://tests/acts/act3/fixtures/captured_policy_legacy/"
var _host: CinderLevel
var _quiet: int = 0

func _run() -> void:
	root.size = Vector2i(340, 736)
	root.content_scale_size = root.size
	root.content_scale_mode = Window.CONTENT_SCALE_MODE_CANVAS_ITEMS
	var index: Variant = JSON.parse_string(FileAccess.get_file_as_string(FIXTURES + "index.json"))
	if not _expect(index is Dictionary and index.get("packets") is Array and index.packets.size() == 6, "Genuine six-packet original producer index required"): quit(1); return
	for entry: Dictionary in index.packets:
		if not await _literal_case(entry): await _close(); break
		await _close()
	print("Crystalman original captured-policy literals: %d checks/%d failures. Literal original phase/Player+Store and later legacy join/contact only; declared TEST host, no whole-parent campaign/route credit." % [_checks, _failures])
	quit(0 if _failures == 0 else 1)

func _literal_case(entry: Dictionary) -> bool:
	var path: String = FIXTURES + entry.exact_file
	var store_path: String = FIXTURES + entry.store_file
	var wire: String = FileAccess.get_file_as_string(path)
	var raw: PackedByteArray = FileAccess.get_file_as_bytes(store_path)
	if not _expect(FileAccess.get_sha256(path) == entry.exact_sha256 and FileAccess.get_sha256(store_path) == entry.store_sha256 and wire.to_utf8_buffer().size() == entry.exact_bytes and raw.size() == entry.store_bytes, "Original literal wire/rawStore bytes match native producer hashes"): return false
	var parsed: Dictionary = Exact.parse(wire)
	if not _expect(parsed.get("accepted", false) and parsed.get("value") is Dictionary, "Original Exact wire decodes without reencoding or schema edits"): return false
	var saved: Dictionary = parsed.value
	var uri: String = "user://test-original-policy-%d-%s-%s.json" % [OS.get_process_id(), entry.profile, entry.stage]
	var file := FileAccess.open(uri, FileAccess.WRITE)
	if not _expect(file != null, "Isolated literal raw Store byte recipient opens"): return false
	file.store_buffer(raw); file.close()
	var disk: Dictionary = Store.new(uri).read_payload()
	DirAccess.remove_absolute(ProjectSettings.globalize_path(uri))
	if not _expect(Exact.stringify(disk) == wire and saved.phase.api_revision == "act3-crystalman-captured-phase-2" and saved.phase.schema_version is int and saved.phase.schema_version == 2 and not saved.phase.has("policy"), "Real format2 reader retains exact original old unit without new policy"): return false
	paused = false
	_game = MainScene.instantiate()
	_game.set_script(ProfileMain)
	_game.set("policy_test_preference", "challenge" if entry.profile == "assisted" else "assisted")
	_game.set("level_scene_path", PARENT)
	root.add_child(_game)
	_game.call("open_bench")
	_host = _game.get("active_level") as CinderLevel
	_hero = _game.get("player") as CinderPlayer
	# Dispose the unused current fresh constructor, retaining its exact actual
	# parent floor. This is native TEST topology setup, never saved unit edits.
	_host.exit_level()
	_room = Phase.new()
	_room.name = "CurrentCapturePhase1"
	_host.add_child(_room)
	# Explicit TEST Main recipient binding only. Original production parent is
	# inactive; the real phase now supplies its own shared camera/input services.
	_game.set("active_level", _room)
	await process_frame
	if not _expect(_room.call("prepare_parent_restore", saved.phase, saved.player, _hero, _game.get("fx"), _game), "Fresh paused actual phase constructor accepts saved legacy profile before once-configure"): return false
	_scheduler = _room.get("threat_scheduler") as CinderThreatScheduler
	_gate = _room.get("capture_gate") as CinderReplayCaptureGate
	_watch(_room); _watch(_hero)
	var count: int = _quiet
	if not _expect(_hero.snapshot_error(saved.player).is_empty() and String(_room.call("native_state_error", saved.phase, saved.player)).is_empty() and _hero.restore_state(saved.player) and _room.call("restore_parent_state", saved.phase, saved.player) and _quiet == count, "Original whole player-first/phase quiet commit with no callbacks"): return false
	if not _expect(Exact.stringify({"player": _hero.snapshot_state(), "phase": _room.call("capture_native_state", _hero.snapshot_state(), false)}) == wire and _room.call("captured_codec_policy").is_empty() and _scheduler.encounter_profile().id == entry.profile and _room.finish_restore_candidate(), "Old literal gen0/recording/warning recaptures exact and retains old mode despite opposite current preference"): return false
	_hp = _hero.hp; _kit = _hero.equipment.snapshot()
	_events.clear(); _retirements.clear(); _blast_seen = false
	_gate.sequence_retired.connect(_on_retired)
	_hero.fired.connect(_on_fired)
	_barrier = Barrier.new(); root.add_child(_barrier)
	var floor: Dictionary = _room.call("floor_regions")[0]
	_floor_collision = floor.collision
	_floor_transform = _floor_collision.global_transform
	_floor_size = (_floor_collision.shape as BoxShape3D).size
	_game.call("resume_lab")
	if entry.stage != "warning":
		if not await _wait_phase("recording", 180): return false
		if not await _record_valid(Vector3.BACK): return false
		if not await _wait_phase("warning", 240): return false
	var owner: CinderReplayPlayback = _room.get("playback") as CinderReplayPlayback
	if not _expect(owner.state().api_revision == "replay-playback-1" and owner.get_captured_policy().is_empty() and _room.call("state").sequence.authored.warning_s == 1.3 and _room.call("state").sequence.authored.final_recovery_s == 3.5, "Old unfinished gen0/recording later joins original Playback/full-raw/fixed-outer policy"): return false
	if not await _wait_locked(): return false
	var record: Dictionary = owner.preview_state().slots[0].events[0].record
	var original_sequence: String = Exact.stringify(_room.call("state").sequence)
	var raw_damage: float = float(record.damage)
	var armour: float = _hero.equipment.resolved_stats().armour
	# The original recorder naturally remains at this original attack origin;
	# choose no evasion. This is actual contact, with no Hero pose assignment.
	if not _expect(_hero.global_position.distance_to(record.world_origin) < 0.02, "Actual saved/completed recorder remains at original origin before native contact"): return false
	var hp: float = _hero.hp
	owner.event_dispatched.connect(_on_replay_event)
	for _i: int in range(180):
		await physics_frame; await process_frame
		if not _events.is_empty(): break
	_game.call("open_bench")
	await process_frame
	return _expect(_events.size() == 1 and owner.state().opportunities[0].damage_attempted and absf(_hero.hp - (hp - raw_damage / armour)) < 0.000001 and Exact.stringify(_room.call("state").sequence) == original_sequence and FileAccess.get_sha256(path) == entry.exact_sha256 and FileAccess.get_sha256(store_path) == entry.store_sha256, "Actual later old-policy contact uses full original raw damage once; original sequence/literal Store bytes unchanged")

func _on_retired(_sequence: Dictionary, retirement: Dictionary) -> void:
	_retirements.append(retirement.duplicate(true))

func _watch(node: Node) -> void:
	for row: Dictionary in node.get_signal_list():
		if row.name in ["fired", "world_action_executed", "sequence_retired", "gate_failed", "reservation_invalidated", "state_changed", "event_dispatched", "playback_failed", "recording_rejected", "recording_joined", "tether_severed"]:
			var callback: Callable = Callable(self, "_quiet" + str(row.args.size()))
			if callback.is_valid(): node.connect(row.name, callback)
	for child: Node in node.get_children(): _watch(child)
func _quiet0() -> void: _quiet += 1
func _quiet1(_a: Variant) -> void: _quiet += 1
func _quiet2(_a: Variant, _b: Variant) -> void: _quiet += 1
func _quiet3(_a: Variant, _b: Variant, _c: Variant) -> void: _quiet += 1
