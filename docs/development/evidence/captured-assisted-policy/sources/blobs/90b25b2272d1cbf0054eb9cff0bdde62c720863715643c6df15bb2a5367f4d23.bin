+func _native_two_slot_unit() -> void:
+	_selected_profile = "assisted"
+	var arena: Dictionary = await _arena()
+	var recorded: Dictionary = await _record_policy(arena, 2)
+	if recorded.is_empty(): await _dispose(arena); return
+	if not _must(recorded.policy.capacity == 2 and recorded.policy.authored.inter_echo_gap_s == 1.0 and recorded.native.capture_snapshot.slots.size() == 2 and recorded.native.timeline.slots.size() == 2, "Real two-slot capture retains canonical Assisted outer budget/gap and original records"): await _dispose(arena); return
+	var installed: Dictionary = _install_policy(arena, recorded)
+	if installed.is_empty(): await _dispose(arena); return
+	await _lock(arena, installed)
+	paused = true
+	await process_frame
+	var bundle: Dictionary = _save_pair(arena, installed.playback, "policy-two-slot-unit")
+	if not _must(not bundle.playback.is_empty() and bundle.playback.api_revision == Playback.CAPTURED_POLICY_API_REVISION and bundle.playback.captured_policy.capacity == 2, "Actual native two-slot committed policy unit writes whole Store payload"): await _dispose(arena); return
+	var fresh: Dictionary = _fresh_policy_pair(arena, installed, bundle)
+	if not fresh.is_empty():
+		_expect(Policy.exact_equal(fresh.playback.get_captured_policy(), recorded.policy) and fresh.playback.preview_state().slots.size() == 2, "Independent fresh two-slot native recipient retains exact full policy/records after quiet transport")
+	# Bind/commit/whole native transport only, not a second contact or a whole
+	# two-slot Crystalman parent/route result. No record/HP/clock rewrite.
+	await _dispose(arena)
+
+
 func _fresh_policy_pair(arena: Dictionary, installed: Dictionary, bundle: Dictionary) -> Dictionary:
 	if bundle.get("playback", {}).is_empty(): return {}
 	var hero: CinderPlayer = Player.new()
