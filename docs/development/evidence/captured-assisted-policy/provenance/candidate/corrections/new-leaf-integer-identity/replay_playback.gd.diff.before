+
+## Explicit opt-in. Original configure remains API1/full recorded raw damage.
+## The policy never modifies original captured records/timeline/event payloads.
+func configure_captured_policy(playback_id: String, sequence_snapshot: Dictionary, source_epoch: String, generation: int, policy: Dictionary, presentation_id: String = "act3_traveller") -> bool:
+	if get_script() != CinderReplayPlayback or not _configuration.is_empty() or not _captured_policy.is_empty() or _transaction_depth > 0 or not _stable_id(playback_id) or not Sprite.PRESENTATION_IDS.has(presentation_id): return _reject("Configure one fresh exact-native explicit captured-policy playback")
+	var reader = Sequence.new()
+	if not reader.restore_state(sequence_snapshot, source_epoch, generation): return _reject("Invalid frozen captured sequence: " + reader.last_snapshot_error)
+	var plan: Dictionary = reader.state()
+	var selected: Dictionary = policy.get("profile", {}) if policy.get("profile") is Dictionary else {}
+	var error: String = CapturedPolicy.error(policy, selected, plan.capture_snapshot.slots.size(), plan.authored.tether_position)
+	if error.is_empty() and not _same_transport(reader.snapshot_state().authored, policy.authored): error = "Captured sequence outer recipe differs from explicit canonical policy"
+	if not error.is_empty(): return _reject(error)
+	_captured_policy = policy.duplicate(true)
+	_captured_policy_seal = Exact.stringify(_captured_policy)
+	_configuration = {"playback_id": playback_id, "sequence": reader.snapshot_state(), "source_epoch": source_epoch, "generation": generation, "presentation_id": presentation_id}
+	_plan = plan
+	if is_node_ready(): _build_preview()
+	last_error = ""
+	return true
+
+func get_captured_policy() -> Dictionary:
+	return _captured_policy.duplicate(true)
+
+func _captured_policy_error(profile: Dictionary) -> String:
+	if _captured_policy.is_empty(): return ""
+	if _authored() or _cycle_tracking or _plan.get("api_revision") != Sequence.API_REVISION: return "Captured policy cannot apply to enemy-authored/managed programmes"
+	# Configure independently authenticated canonical derivation once. Live
+	# guards rejoin retained bytes and the ACTUAL frozen native profile without
+	# reopening the catalogue on every cue/delivery/physics boundary.
+	if _captured_policy_seal.is_empty() or Exact.stringify(_captured_policy) != _captured_policy_seal: return "Retained captured policy identity changed after configure"
+	if not _same_transport(_captured_policy.profile, profile) or _captured_policy.capacity != _plan.capture_snapshot.slots.size() or not _same_transport(_captured_policy.authored.tether_position, Codec.vector3(_plan.authored.tether_position)): return "Captured policy differs from actual frozen profile/plan/capacity/tether"
+	if not _same_transport(_configuration.sequence.authored, _captured_policy.authored): return "Captured policy cannot replace original immutable sequence budgets"
+	return ""
 
