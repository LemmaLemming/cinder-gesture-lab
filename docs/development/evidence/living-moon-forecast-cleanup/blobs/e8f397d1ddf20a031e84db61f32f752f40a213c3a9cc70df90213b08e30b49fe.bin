  "finite_source_case": {
    "inputs": "Running final-stage Moon with a committed Blink frame/lease; stationary Hero. Nose native preview accepted with finite candidate/proof and valid primary timing, but prospective combined camera point union has rejected plan (actual reason: fixed-width HUD-safe rectangle cannot fit).",
    "transition": [
      {
        "step": 1,
        "method": "_prepare_forecast canonical244–255",
        "effect": "Writes candidate source/geometry/response points to _forecast, caches current Hero transform in _forecast_hero and stages _pending_start."
      },
      {
        "step": 2,
        "method": "_framing_ready/_framing_error canonical585–592",
        "effect": "Calls pure planner on combined committed+forecast points. Hard plan rejected -> nonempty error -> false."
      },
      {
        "step": 3,
        "method": "_prepare_forecast canonical255",
        "effect": "Clears only _pending_start, returnsfalse. _forecast and _forecast_hero remain assigned."
      },
      {
        "step": 4,
        "method": "_admit_nose canonical238 / _finish_admission canonical259–266",
        "effect": "Caller returns onfalse, so _finish_admission (which would clear forecast) never runs. No Nose lease was admitted."
      },
      {
        "step": 5,
        "method": "_camera_framing_points canonical563–582, especially577",
        "effect": "Default include_forecast=true appends rejected prospective points while Hero transform unchanged. _source_guard uses false and excludes them; _prune_frames only prunes accepted frame records and does not retire forecast."
      },
      {
        "step": 6,
        "method": "Game._update_camera471–497",
        "effect": "Normal follow lerps _camera_focus first, then calls active level default points. Rejected plan leaves lerped focus in place and publishes its camera position without committed-only fallback. Thus a nonadmitted impossible candidate can interfere with framing a currently valid committed exchange."
      }
    ],
    "invariant_breach": "A hard-rejected prospective proposal is neither an admitted exchange nor a feasible camera preparation; it must not remain published as an applicable mandatory set that prevents planning for unchanged live commitments. This is deterministic source behavior, also observed as retained rejected forecast in actual passive packets.",
    "additional_stale_path": "Upfront preview/candidate/proof/timing error branches also return without retiring any previous forecast. Once no longer a valid proposal, stale candidate state can survive subsequent early refusal while Hero remains unchanged.",
    "not_a_guard_defect": "Native source guard correctly refuses unavailable presentation; nothing here permits suppressing it. Global Game follow-on-reject behavior is a consumer of poisoned input, not itself selected for modification by this review."
  },
  "critical_soft_vs_hard_distinction": {
    "hard": "Planner accepted=false for the prospective union: discard/rollback its unpublished forecast and pending start, preserving live _frames/leases and actual diagnostics.",
    "soft": "Planner accepted=true but current containment not yet satisfied: retain the feasible forecast for normal camera preparation while still refusing source admission/damage until actual current containment passes.",
    "why_not_blanket_clear": "Clearing forecast on every false _framing_ready would remove the existing pre-admission camera-preparation mechanism and could prevent valid sources from ever framing. Clearing all forecasts indiscriminately is not the recommended fix."
  },
