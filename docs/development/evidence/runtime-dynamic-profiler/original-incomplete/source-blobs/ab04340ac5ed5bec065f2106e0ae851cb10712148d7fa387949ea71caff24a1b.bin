"""Host parser for official Godot local stdout profiling; no engine or file actions."""
from decimal import Decimal, InvalidOperation
from collections import Counter
import re

NUMBER = r"[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?"
HEADER = re.compile(r"^(\d+):(.+)$")
TIMING = re.compile(r"^\s*total:\s+("+NUMBER+r")/([+-]?\d+)\s*%\s+self:\s+("+NUMBER+r")/([+-]?\d+)\s*%\s+tcalls:\s+(\d+)\s*$")

def require(ok, message):
    if not ok: raise ValueError(message)

def number(text):
    try: value = Decimal(text)
    except InvalidOperation as exc: raise ValueError("invalid profiler decimal") from exc
    require(value.is_finite() and value >= 0, "nonnegative finite profiler time required")
    return value

def parse_profiler(raw, targets):
    require(type(raw) is str and type(targets) is list, "raw/target types differ")
    lines = raw.splitlines()
    begin = [i for i,l in enumerate(lines) if l == "BEGIN PROFILING"]
    accumulated = [i for i,l in enumerate(lines) if l.startswith("ACCUMULATED: total: ")]
    require(len(begin) == 1 and len(accumulated) == 1 and begin[0] < accumulated[0],
            "one complete profiler begin/final accumulated block required")
    start = accumulated[0]
    total_text = lines[start].removeprefix("ACCUMULATED: total: ")
    number(total_text)
    rows = []; i = start + 1
    while i < len(lines):
        line = lines[i]
        require(not line.startswith("FRAME:") and line != "BEGIN PROFILING", "unexpected profiler restart/frame after final block")
        header = HEADER.fullmatch(line)
        if header is None:
            require(not line.lstrip().startswith("total:") and not line.startswith("ACCUMULATED:"), "orphan or duplicate profiler data")
            i += 1; continue
        require(int(header[1]) == len(rows), "profiler indices must be complete and sequential")
        require(i+1 < len(lines), "profiler row missing timing line")
        timing = TIMING.fullmatch(lines[i+1])
        require(timing is not None, "profiler row timing/calls malformed")
        inclusive = number(timing[1]); own = number(timing[3])
        require(own <= inclusive and int(timing[2]) >= 0 and int(timing[4]) >= 0, "profiler displayed self/inclusive/percent values invalid")
        rows.append({"index":int(header[1]),"signature":header[2],
                     "inclusive_seconds_text":timing[1],"self_seconds_text":timing[3],
                     "inclusive_percent_text":timing[2],"self_percent_text":timing[4],
                     "calls":int(timing[5]),"source_line_1based":i+1,
                     "raw_signature_line":line,"raw_timing_line":lines[i+1]})
        i += 2
    require(rows and len(rows) < 32768, "empty/capacity-bound capture is incomplete")
    signature_counts = Counter(r["signature"] for r in rows)
    matched = []
    for target in targets:
        name = re.compile(r"(?:^|[:\s])"+re.escape(target["function"])+r"(?:$|\()")
        found = [r["index"] for r in rows if target["path"] in r["signature"] and name.search(r["signature"])]
        matched.append({**target,"row_indices":found,"matched":bool(found)})
    required = [("scripts/combat/threat_scheduler.gd","replay_reservation_error"),
                ("scripts/combat/threat_scheduler.gd","authored_replay_source_error"),
                ("scripts/combat/replay_program.gd","_restore_authored_for_source_guard"),
                ("scripts/combat/authored_enemy_sequence.gd","snapshot_error")]
    require(all(any(t["path"]==p and t["function"]==n and t["matched"] for t in matched) for p,n in required),
            "required actual guard/source signatures absent; do not infer zero")
    return {"schema":1,"complete":True,"scope":"Entire unchanged113 process startup-to-shutdown, including admission/manual/automatic advances, fixed probes and cleanup. Not automatic-tick-only.",
            "rows":rows,"record_count":len(rows),"matched_targets":matched,
            "duplicate_signatures":sorted(s for s,n in signature_counts.items() if n > 1),
            "missing_optional_targets":[{"path":t["path"],"function":t["function"]} for t in matched if not t["matched"]],
            "accumulated_script_self_total_seconds_text":total_text,
            "accumulated_start_line_1based":start+1,
            "raw_accumulated_block":"\n".join(lines[start:])+"\n",
            "limits":"Actual dynamic function counts; inclusive scopes overlap. Preserve decimal display precision; do not subtract transitive probe calls, sum inclusive rows, or derive per-tick/FPS/causal costs."}
