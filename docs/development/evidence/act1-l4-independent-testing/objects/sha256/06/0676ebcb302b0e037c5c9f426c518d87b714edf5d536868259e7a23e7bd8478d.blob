extends RefCounted
## TMP-only O1 art draft. Existing Heath leaves, new journal/exit props only.
## No collider, target group, cue, timer, process, collection or progression.
## Host supplies native floor/colliders, shared InteractionCues and saved state.

const Heath: Script = preload("res://scripts/acts/act2/heath_kit.gd")
const ART_REVISION: String = "a2-o1-cylinder-perimeter-kit-1"
const FLOOR_RECT: Rect2 = Rect2(-3.4, -10.8, 6.8, 14.4)
const JOURNAL_IDS: Array[String] = ["west", "east", "north"]
const JOURNAL_POSITIONS: Dictionary = {
	"west": Vector3(-2.05, 0.0, -0.6),
	"east": Vector3(2.05, 0.0, -0.6),
	"north": Vector3(-1.4, 0.0, -8.9),
}
const EXIT_POSITION: Vector3 = Vector3(0.0, 0.0, -9.9)
const TRUNK_POSITION: Vector3 = Vector3(0.0, 0.0, -3.6)
const PROP_STATES: Array[String] = ["available", "active", "spent", "hidden"]


static func build(parent: Node3D) -> Dictionary:
	assert(is_instance_valid(parent), "Cylinder Perimeter art requires an owned parent")
	var root := Node3D.new()
	root.name = "CylinderPerimeterKit"
	root.set_meta("art_revision", ART_REVISION)
	root.set_meta("source_ids", ["G05", "G16", "G18", "sample-S01"])
	root.set_meta("scenery_only", true)
	root.set_meta("floor_rect_proposal", FLOOR_RECT)
	root.set_meta("optional_cutaway_paths", [])
	parent.add_child(root)
	_ground(root)
	_boundary_dressing(root)
	# Reuse the existing complete shell/lid/heaps leaf, not Heath.build's long
	# L1 layout, witnesses, eruption or route-dependent animation state.
	Heath._cylinder_landmark(root)
	Heath._pine(root, Vector3(-3.85, 0.0, -2.2), -1, 0)
	Heath._pine(root, Vector3(3.85, 0.0, -5.2), 1, 1)
	Heath._log(root, Vector3(-3.85, 0.0, -7.6), -1, 0, true)
	Heath._log(root, Vector3(3.85, 0.0, -1.8), 1, 1, true)
	Heath._cottage(root, Vector3(4.65, 0.0, -8.0), 1, 1)
	for side: int in [-1, 1]:
		for index: int in range(4):
			var patch := Node3D.new()
			patch.name = "Heather_%s_%s" % [side, index]
			root.add_child(patch)
			Heath._heather(patch, Vector3(float(side) * 3.9, 0.025, 1.0 - float(index) * 3.2), index % 3)
	_loop_trunk(root)
	var journals: Dictionary = {}
	for id: String in JOURNAL_IDS:
		journals[id] = _journal(root, id, JOURNAL_POSITIONS[id])
	var marker: Node3D = _exit_marker(root)
	# Repeated legacy helper leaf names may receive native autogenerated IDs.
	# Normalize those cosmetic names deterministically before recording paths.
	_normalize_names(root)
	_mark_optional_meshes(root, root)
	var kit: Dictionary = {"root": root, "journals": journals, "exit_marker": marker}
	for id: String in JOURNAL_IDS:
		set_journal(kit, id, "available")
	set_exit(kit, "hidden")
	return kit


static func set_journal(kit: Dictionary, id: String, state: String) -> void:
	if not JOURNAL_IDS.has(id) or not PROP_STATES.has(state): return
	var journals: Variant = kit.get("journals")
	if not journals is Dictionary: return
	var raw: Variant = journals.get(id)
	if not is_instance_valid(raw) or not raw is Node3D: return
	var prop: Node3D = raw
	prop.visible = state != "hidden"
	(prop.get_node("FoldedPaper") as Node3D).visible = state == "available"
	(prop.get_node("OpenedPaper") as Node3D).visible = state == "active"
	prop.set_meta("visual_state", state)


static func set_exit(kit: Dictionary, state: String) -> void:
	if not PROP_STATES.has(state): return
	var raw: Variant = kit.get("exit_marker")
	if not is_instance_valid(raw) or not raw is Node3D: return
	var marker: Node3D = raw
	marker.visible = state != "hidden"
	var sign: Node3D = marker.get_node("QuietRoadSign") as Node3D
	sign.rotation.z = -0.08 if state == "active" else (0.28 if state == "spent" else 0.0)
	marker.set_meta("visual_state", state)


static func _ground(root: Node3D) -> void:
	var ground := Node3D.new()
	ground.name = "QuietGroundSurfaces"
	ground.set_meta("o1_keep_opaque", true)
	root.add_child(ground)
	# Exterior terrain is scenery behind the host's bank colliders. It fills
	# the portrait foreground without claiming additional playable support.
	Heath._plane(ground, "OuterHeath", Vector3(0.0, 0.002, -3.6), Vector2(16.0, 35.2), "heath")
	Heath._plane(ground, "DryPaleSand", Vector3(0.0, 0.004, -3.6), Vector2(6.8, 14.4), "sand")
	Heath._plane(ground, "LoopClearing", Vector3(0.0, 0.008, -2.4), Vector2(6.4, 8.4), "sand_clear")
	Heath._plane(ground, "NorthReturnRoad", Vector3(0.0, 0.010, -8.35), Vector2(5.4, 4.5), "road")
	for side: int in [-1, 1]:
		for index: int in range(3):
			Heath._plane(ground, "OuterScorch_%s_%s" % [side, index], Vector3(float(side) * 4.2, 0.011, -0.8 - float(index) * 4.0), Vector2(0.6, 1.1), "scorch")


static func _boundary_dressing(root: Node3D) -> void:
	var banks := Node3D.new()
	banks.name = "HostBoundaryVisuals"
	root.add_child(banks)
	# Suggested native bodies exactly match these grounded meshes: side bank
	# centersX+-3.65, end centersZ3.9/-11.1, height1 centeredY.45.
	for side: int in [-1, 1]:
		Heath._box(banks, "SideBank_%s" % side, Vector3(float(side) * 3.65, 0.45, -3.6), Vector3(0.5, 1.0, 14.4), Heath._material("heath"))
		for index: int in range(3):
			var stone: MeshInstance3D = Heath._box(banks, "RoadStone_%s_%s" % [side, index], Vector3(float(side) * 3.95, 0.05, 0.8 - float(index) * 4.2), Vector3(0.22, 0.10, 0.35), Heath._material("stone"))
			stone.rotation.y = float(side) * 0.17
	for z: float in [3.9, -11.1]:
		Heath._box(banks, "NearEndBank" if z > 0.0 else "FarEndBank", Vector3(0.0, 0.45, z), Vector3(7.8, 1.0, 0.6), Heath._material("heath"))
	# Thin grounded footprints stay opaque even when an upper bank fades.
	var bases := Node3D.new()
	bases.name = "PersistentBoundaryFeet"
	bases.set_meta("o1_keep_opaque", true)
	root.add_child(bases)
	for side: int in [-1, 1]:
		Heath._plane(bases, "SideBankBase_%s" % side, Vector3(float(side) * 3.65, 0.013, -3.6), Vector2(0.5, 14.4), "heath")
	for z: float in [3.9, -11.1]:
		Heath._plane(bases, "NearEndBankBase" if z > 0.0 else "FarEndBankBase", Vector3(0.0, 0.013, z), Vector2(7.8, 0.6), "heath")


static func _loop_trunk(root: Node3D) -> void:
	var trunk := Node3D.new()
	trunk.name = "LoopGroundedTrunk"
	trunk.position = TRUNK_POSITION
	trunk.set_meta("host_collision_proposal", {"kind": "cylinder", "radius": 0.35, "height": 1.2, "center_local": Vector3(0.0, 0.6, 0.0)})
	root.add_child(trunk)
	Heath._cylinder(trunk, "StandingCharredStump", Vector3(0.0, 0.6, 0.0), 0.35, 0.35, 1.2, Heath._material("char"), 7)
	Heath._branch(trunk, Vector3(0.0, 0.72, 0.0), Vector3(0.12, 0.95, 0.03), 0.045, Heath._material("char"), "BrokenInnerTwig")
	var base: MeshInstance3D = Heath._cylinder(trunk, "PersistentTrunkFootprint", Vector3(0.0, 0.008, 0.0), 0.35, 0.35, 0.008, Heath._material("char"), 16)
	base.set_meta("o1_keep_opaque", true)


static func _journal(root: Node3D, id: String, at: Vector3) -> Node3D:
	var prop := Node3D.new()
	prop.name = "Journal_%s" % id
	prop.position = at
	prop.set_meta("journal_id", id)
	prop.set_meta("o1_keep_opaque", true)
	prop.set_meta("source", "A2-O1 documented new contact journal prop; Heath material/primitive family")
	root.add_child(prop)
	Heath._box(prop, "WeatheredBacking", Vector3(0.0, 0.012, 0.0), Vector3(0.58, 0.024, 0.82), Heath._material("wood"))
	var folded := Node3D.new()
	folded.name = "FoldedPaper"
	folded.position.y = 0.024
	folded.rotation.y = 0.12
	prop.add_child(folded)
	_paper_leaf(folded, "JournalLeaf", Vector3.ZERO, Vector2(0.46, 0.66))
	var open := Node3D.new()
	open.name = "OpenedPaper"
	open.position.y = 0.024
	open.rotation.y = -0.12
	prop.add_child(open)
	_paper_leaf(open, "LeftLeaf", Vector3(-0.16, 0.0, 0.0), Vector2(0.32, 0.66))
	_paper_leaf(open, "RightLeaf", Vector3(0.16, 0.008, 0.0), Vector2(0.32, 0.66))
	return prop


static func _paper_leaf(parent: Node3D, label: String, at: Vector3, size: Vector2) -> void:
	var page := Node3D.new()
	page.name = label
	page.position = at
	parent.add_child(page)
	Heath._box(page, "PalePaper", Vector3(0.0, 0.008, 0.0), Vector3(size.x, 0.016, size.y), Heath._material("ash_wood"))
	Heath._box(page, "PaperFold", Vector3(-size.x * 0.38, 0.018, 0.0), Vector3(0.022, 0.004, size.y * 0.9), Heath._material("excavation"))
	for index: int in range(5):
		Heath._box(page, "QuietInkLine_%s" % index, Vector3(0.0, 0.018, -size.y * 0.31 + float(index) * size.y * 0.14), Vector3(size.x * (0.58 if index == 4 else 0.72), 0.002, 0.012), Heath._material("char"))


static func _exit_marker(root: Node3D) -> Node3D:
	var marker := Node3D.new()
	marker.name = "PerimeterExitMarker"
	marker.position = EXIT_POSITION
	marker.set_meta("o1_keep_opaque", true)
	root.add_child(marker)
	Heath._cylinder(marker, "GroundedWeatheredPost", Vector3(-0.35, 0.30, 0.0), 0.055, 0.045, 0.60, Heath._material("wood"), 6)
	var sign: MeshInstance3D = Heath._box(marker, "QuietRoadSign", Vector3(-0.07, 0.48, 0.0), Vector3(0.68, 0.15, 0.055), Heath._material("ash_wood"))
	Heath._box(sign, "DarkDirectionalNotch", Vector3(0.20, 0.0, 0.030), Vector3(0.025, 0.07, 0.008), Heath._material("char"))
	return marker


static func _normalize_names(parent: Node) -> void:
	var children: Array[Node] = parent.get_children()
	for index: int in range(children.size()):
		var child: Node = children[index]
		if String(child.name).begins_with("@"):
			child.name = "%s_%03d" % [child.get_class(), index]
		_normalize_names(child)


static func _mark_optional_meshes(root: Node3D, branch: Node) -> void:
	if bool(branch.get_meta("o1_keep_opaque", false)): return
	if branch is MeshInstance3D:
		var mesh: MeshInstance3D = branch
		var material: StandardMaterial3D = mesh.material_override as StandardMaterial3D
		if material != null:
			mesh.material_override = material.duplicate() as StandardMaterial3D
			mesh.set_meta("weybridge_cutaway_candidate", true)
			var paths: Array = root.get_meta("optional_cutaway_paths", [])
			paths.append(String(root.get_path_to(mesh)))
			root.set_meta("optional_cutaway_paths", paths)
	for child: Node in branch.get_children():
		_mark_optional_meshes(root, child)
