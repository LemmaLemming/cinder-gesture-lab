  "positive_exercise_decisions": [
    {
      "exercise": "Return impact then Rusher",
      "positive_rationale": "One finite isolated impact/recovery and familiar Rusher rehearse commitment and useful landing before the local boss, with genuine prerequisites rather than a new source task.",
      "source": [
        "host170–197",
        "Layout15–20",
        "Concept213–230"
      ]
    },
    {
      "exercise": "Capsule/checkpoint and boss threshold",
      "positive_rationale": "Quiet interruption and blocked-hatch objective orient the low eye/nose and supported ground before broad threshold. Preserve contact versus attack distinctions.",
      "source": [
        "host162–180",
        "Layout20–27"
      ]
    },
    {
      "exercise": "Isolated Blink",
      "positive_rationale": "One sampled ground footprint teaches full escape with a useful return to the unchanged ordinary close eye opening, avoiding simultaneous new shape/target/control.",
      "source": [
        "host203–210/228–233",
        "Body3–9/26–34",
        "Concept218/225"
      ]
    },
    {
      "exercise": "Isolated Sneeze before alternation",
      "positive_rationale": "A different fixed-cone directional footprint is learned alone through genuine recovery before alternating familiar circle; same gestures/eye target retain comparison.",
      "source": [
        "host203/211–218/236–241/269–271",
        "Nose3–8/23–29",
        "Concept219/225"
      ]
    },
    {
      "exercise": "Final expression",
      "positive_rationale": "Stagger already known unlike shapes and retain one low ordinary opening; shared union proof/current-view/source budget govern any actual follower admission. No surprise third mechanic or universal both-lease assertion.",
      "source": [
        "host219–225/233/241/279–285",
        "Concept220/227–228"
      ]
    },
    {
      "exercise": "Defeat, hatch contact and cosmetic escape",
      "positive_rationale": "End combat before contact-triggered objective and0.75s shared-clock presentation; retained contact/escape completion precedes Act2 transition. No capsule controls or new reward.",
      "source": [
        "host288–292/379–415",
        "Layout27–35",
        "Concept221"
      ]
    }
  ],
  "semantic_limits": "Per-exercise teaching/cue/ordinary-opening reasons are supported by actual accepted source+concept. Trial failure is not rationale, impossibility proof or blanket exception. This grants neither a new authored Challenge response nor universal all-profile/all-kit follower/landing proof. Future content still needs its own policy.",
