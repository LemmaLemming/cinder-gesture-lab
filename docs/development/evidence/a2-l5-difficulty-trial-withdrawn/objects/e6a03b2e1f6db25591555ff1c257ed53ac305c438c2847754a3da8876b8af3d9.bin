  "blocking_findings": [
    {
      "id": "F1",
      "priority": "P1",
      "status": "fix_before_engine",
      "title": "Component SaveStore uses a forbidden res:// path",
      "fixture_lines": [
        494,
        500
      ],
      "production_source": "scripts/campaign/save_store.gd:59-61",
      "call_site": "_case:249 calls await _persist(\"before-first-response\", true)",
      "proof": "_run:190 requires output.begins_with(\"res://.cinder/\"). _persist:494 constructs Store.new(output + stem + \".component-store.json\"). Canonical write_payload explicitly returns false for every path not beginning user:// (59-61), with Desktop saves require a user:// path. Thus even a valid native payload is guaranteed to fail its first required Store write before any _drive combat comparison.",
      "impact": "The submitted6127 fixture cannot reach its stated real-response result on the exact pinned SaveStore. This is a TEST persistence-path bug, not a B05 or level failure.",
      "minimal_remedy": "Keep diagnostics in the fresh res:// invocation directory. Allocate a separate fresh invocation-owned user:// Store directory/path before writes, refuse collisions, write the actual format2 payload there, then archive and verify the exact primary/backup raw bytes plus actual user path/hash/size/generation/absence in the res:// evidence before any owned cleanup. Remove only known invocation-owned temporary save files/directory after raw bytes are durably retained. Do not relax SaveStore or skip the required validated payload capture. Preserve constructor/geometry/seed/control policy; no producer or comparison matrix is needed.",
      "not_executed": true
    }
  ],
