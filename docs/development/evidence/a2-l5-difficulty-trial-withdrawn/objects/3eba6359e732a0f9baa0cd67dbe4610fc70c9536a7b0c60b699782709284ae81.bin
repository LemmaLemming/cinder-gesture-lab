var host_control_directory: Dictionary = {}
var host_control_cleanup: Dictionary = {}
var host_control_comparison: Dictionary = {}
var executed_arms: Array[String] = []
var retained_reference: Dictionary = {"arm": "v1", "source_sha256": REFERENCE_FILES["retained-v1-executed.exact.json"].sha256, "source_bytes": 186333, "source_visual_sha256": REFERENCE_VISUAL_SHA, "source_phase": REFERENCE_PHASE, "review_sha256": REFERENCE_FILES["retained-independent-review.json"].sha256, "admitted": false, "safe_wire_roundtrip": false, "scope": "retained source-qualified Challenge/v1 component; original3489/1 overall failed; not a current af04 execution or whole L5 save"}
var retained_join: Dictionary = {"stage": "not_started", "converted_slots": []}
var arm: String = ""
var checks: int = 0
var failures: int = 0
var first_failure: Dictionary = {}
var finishing: bool = false
var started_ms: int = 0
var old_audio: AudioBusLayout
var old_fps: int
var arm_frames: int = 0
var trace_enabled: bool = false
var trace: Array[Dictionary] = []
var commands: Array[Dictionary] = []
var snapshots: Array[Dictionary] = []
var previous: Dictionary = {}
var first_pair: Dictionary = {}
var pair_start: Dictionary = {}
var paired_bait_sample: Dictionary = {}
var pair_command_start: int = 0
var outcome: Dictionary = {}
var results: Dictionary = {}
var note: String = "incomplete"
