  "native_diff": "--- 0686\n+++ 0e63\n@@ -637,12 +637,16 @@\n \t\t\t\t\t\tvar wire: Dictionary = parser.data\n \t\t\t\t\t\tvar serial: Variant = wire.get(\"generation\")\n \t\t\t\t\t\tparsed = (serial is int or serial is float) and is_finite(float(serial)) and serial >= 1 and serial <= Store.MAX_GENERATION and serial == floor(serial) and wire.get(\"format_version\") == Store.FORMAT_VERSION\n-\t\t\t\t\t\tif parsed: row.merge({\"generation\": int(serial), \"format_version\": wire.format_version})\n+\t\t\t\t\t\tif parsed:\n+\t\t\t\t\t\t\tvar validated_generation: int = int(serial)\n+\t\t\t\t\t\t\trow[\"generation\"] = validated_generation\n+\t\t\t\t\t\t\trow[\"format_version\"] = wire.format_version\n+\t\t\t\t\t\t\tparsed = row[\"generation\"] is int and row[\"generation\"] == validated_generation and row[\"generation\"] == serial and row[\"format_version\"] == Store.FORMAT_VERSION\n \t\t\t\t\tif not stable or not parsed:\n \t\t\t\t\t\trow[\"custody_error\"] = \"raw archive stability/header check refused; actual bytes retained\"\n \t\t\t\t\t\tresult.accepted = false\n \t\t\t\t\t# Each unique fresh slot has one real write; never fabricate backup generations.\n-\t\t\t\t\telif stored and suffix.is_empty() and int(row.generation) == generation:\n+\t\t\t\t\telif stored and suffix.is_empty() and row.generation is int and row.generation == generation:\n \t\t\t\t\t\towned_store_files[path] = row.duplicate(true)\n \t\t\t\t\telse:\n \t\t\t\t\t\trow[\"custody_error\"] = \"unexpected/unattributed generation left in situ\"\n",
