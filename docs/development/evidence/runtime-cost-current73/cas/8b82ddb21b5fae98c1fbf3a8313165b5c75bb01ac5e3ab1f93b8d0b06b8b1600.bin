  "callgraph": [
    {
      "source": "replay_playback.gd",
      "lines": "240-342",
      "facts": "Automatic advance checks fresh collision, full reservation error, lease state, a delivery guard, fresh Cursor restore and due event prefix; commits once-only cursor/pending state before draining callbacks."
    },
    {
      "source": "replay_playback.gd",
      "lines": "349-425,1142-1236",
      "facts": "Each event presentation/damage/event signal and final state signal is followed by its own guard; renderer/cue presentation also rechecks. These callback/native boundaries remain mandatory."
    },
    {
      "source": "threat_scheduler.gd",
      "lines": "463-492",
      "facts": "Each successful authored reservation error traverses context/cycle/source error then stationary floor handles, another fresh collision signature and cooldown, with original error precedence."
    },
    {
      "source": "threat_scheduler.gd",
      "lines": "573-611",
      "facts": "Source error validates closed context/sequence, constructs fresh exact Program/Authored reader, materializes reader.state(), invokes the actual source getter, rechecks native identity, freshly computes floor/collision and tail rechecks catalogue/wire/binding."
    },
    {
      "source": "replay_program.gd",
      "lines": "63-93",
      "facts": "Source-only factory creates a fresh exact Authored reader; state() delegates to its defensive native decoding copy. No external reader alias escapes before Scheduler's source getter."
    },
    {
      "source": "authored_enemy_sequence.gd",
      "lines": "62-81,174-225",
      "facts": "state() duplicates the complete validated wire and converts all definition/timeline vectors; source guard retains immutable private copy and resets same-call validation sink before native getter. Catalogue equivalence is freshly read in the later binding tail."
    },
    {
      "source": "replay_cursor.gd",
      "lines": "110-194",
      "facts": "Restore validates a fresh Program inside snapshot_error and again for retained plan. This is structurally repeated pure work, but public virtual validation and prior withdrawn plan-reuse experiment preclude simply removing it."
    }
  ],
