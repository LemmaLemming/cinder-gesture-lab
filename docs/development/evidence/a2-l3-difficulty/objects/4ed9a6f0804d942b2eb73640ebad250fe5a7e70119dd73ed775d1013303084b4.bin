"""Strict closed original-entrance report joins; never a Godot Variant decoder."""
from pathlib import Path
import hashlib
import json
import math
import os
import re
import stat


def require(ok, reason):
    if not ok:
        raise ValueError(reason)


def digest(data):
    return hashlib.sha256(data).hexdigest()


def strict(data):
    def pairs(items):
        result = {}
        for key, value in items:
            require(key not in result, "Duplicate JSON key: " + key)
            result[key] = value
        return result
    def finite_float(token):
        value = float(token)
        require(math.isfinite(value), "Nonfinite JSON exponent: " + token)
        return value
    return json.loads(data.decode("utf-8", errors="strict"), object_pairs_hook=pairs, parse_float=finite_float,
                      parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))


def stable(path):
    path = Path(path)
    require(path.is_absolute() and path.resolve() == path, "Literal nonsymlink absolute path required: " + str(path))
    before = path.lstat()
    require(stat.S_ISREG(before.st_mode), "Regular file required: " + str(path))
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    with os.fdopen(fd, "rb") as stream:
        opened = os.fstat(stream.fileno())
        require((opened.st_dev, opened.st_ino) == (before.st_dev, before.st_ino), "Input changed before open")
        data = stream.read()
        after_fd = os.fstat(stream.fileno())
    second = path.read_bytes()
    after = path.lstat()
    fields = lambda s: (s.st_dev, s.st_ino, s.st_size, s.st_mode, s.st_mtime_ns)
    require(fields(before) == fields(opened) == fields(after_fd) == fields(after) and data == second,
            "Unstable literal file readback: " + str(path))
    return {"path": str(path), "sha256": digest(data), "bytes": len(data),
            "mode": format(stat.S_IMODE(after.st_mode), "04o"), "stable_two_reads": True}, data



def observe(out, root, spec, raw, api_return, child_return):
    """Join actual native JSON, literal PNG and process closure; never visual QA."""
    import struct
    result = {"functional_pass": False, "retained": [], "report_present": False}
    report = out / "case/portrait.json"
    png = out / "case/place-warning.png"
    try:
        for path in [report, png]:
            if path.exists():
                meta, _ = stable(path); result["retained"].append(meta)
        require(report.exists(), "Actual portrait report absent; no pass reconstructed")
        meta, data = stable(report); packet = strict(data); result["report_present"] = True
        require(type(packet) is dict and set(packet) == {"api_revision", "complete", "success", "checks", "failures", "first_failure", "rows", "observation"}
                and packet["api_revision"] == "a2-l3-brief-place-portrait-1", "Closed portrait report API/fields differ")
        rows = packet["rows"]
        require(type(rows) is list and bool(rows) and all(type(row) is dict and set(row) == {"index", "passed", "label"}
                and type(row["index"]) is int and row["index"] == index and type(row["passed"]) is bool
                and type(row["label"]) is str for index,row in enumerate(rows,1)), "Exact sequential portrait row types differ")
        failed = [row for row in rows if not row["passed"]]
        require(type(packet["checks"]) is int and packet["checks"] == len(rows) and type(packet["failures"]) is int
                and packet["failures"] == len(failed) and type(packet["complete"]) is bool and type(packet["success"]) is bool
                and packet["complete"] == packet["success"] and packet["first_failure"] == (failed[0]["label"] if failed else ""),
                "Actual portrait count/failure/first-failure/complete join differs")
        uri = "res://" + str(report.relative_to(root))
        footer = "A2-L3 PORTRAIT: %d checks, %d failures; complete=%s; report=%s" % (len(rows),len(failed),str(packet["complete"]).lower(),uri)
        require([line for line in raw.splitlines() if line.startswith("A2-L3 PORTRAIT:")] == [footer], "Actual portrait footer differs")
        require([line for line in raw.splitlines() if line.startswith("FAIL: ")] == ["FAIL: "+row["label"] for row in failed], "Actual FAIL rows differ")
        result["joins"] = {"checks":len(rows),"failures":len(failed),"first_failure":packet["first_failure"],"complete":packet["complete"],
                           "api_return":api_return,"owned_child_return":child_return,"native_report_sha256":meta["sha256"]}
        require(not failed and packet["complete"] is True and packet["success"] is True and api_return == 0 and child_return == 0,
                "Actual portrait incomplete/failed/API/owned process nonzero")
        observation = packet["observation"]
        require(type(observation) is dict and observation.get("status") == "running" and observation.get("phase") in ["warning","lock"]
                and type(observation.get("cycle")) is int and observation["cycle"] == 1 and observation.get("profile") == "challenge"
                and observation.get("tree_paused_at_draw") is True and type(observation.get("published_points")) is int
                and observation["published_points"] > 0 and observation.get("current_containment_error") == ""
                and observation.get("runtime_error") == "" and observation.get("hp") == 100 and observation.get("shells") == 2
                and type(observation.get("renderer")) is str and bool(observation["renderer"]), "Actual native capture observation differs")
        image, literal = stable(png)
        require(len(literal) >= 33 and literal[:8] == b"\x89PNG\r\n\x1a\n" and literal[12:16] == b"IHDR", "Actual PNG header absent")
        width,height = struct.unpack(">II",literal[16:24])
        require(height > width and width >= spec["portrait_min_width"] and observation.get("image_width") == width and observation.get("image_height") == height
                and observation.get("png_sha256") == image["sha256"], "Literal PNG dimensions/hash/observation differ")
        require({p.name for p in (out/"case").iterdir()} == {"portrait.json","place-warning.png"}, "Owned complete portrait output whitelist differs")
        require({row["label"] for row in rows if row["passed"]} >= {"normal exit releases all observed descendants","normal group cleanup: enemies",
                "normal group cleanup: practice_targets","normal group cleanup: environment_attack_targets"}, "Normal native cleanup assertions missing")
        after, again = stable(report); require(after == meta and again == data, "Report changed during joins")
        result.update(functional_pass=True,observation=observation,png={"path":str(png),"sha256":image["sha256"],"bytes":image["bytes"],"width":width,"height":height},
                      qualification="Actual rendered PNG retained; Root must inspect these pixels. No automated visual/balance/campaign proof.")
    except Exception as error:
        result["error"] = str(error)
    return result
