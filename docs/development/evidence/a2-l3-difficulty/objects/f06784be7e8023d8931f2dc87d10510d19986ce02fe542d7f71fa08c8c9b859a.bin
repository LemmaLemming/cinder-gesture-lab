+func _valid_output() -> bool:
+	if not output.begins_with("res://.cinder/") or output.contains("\\") or output.ends_with("/"): return false
+	for part: String in output.trim_prefix("res://").split("/"):
+		if part.is_empty() or part in [".",".."] or part.contains(":"): return false
+	return DirAccess.dir_exists_absolute(ProjectSettings.globalize_path(output)) and DirAccess.get_files_at(ProjectSettings.globalize_path(output)).is_empty() and DirAccess.get_directories_at(ProjectSettings.globalize_path(output)).is_empty()
+
+func _on_draw() -> void:
+	# Freeze at the actual rendered boundary, without moving camera or actors.
+	draw_seen = true
+	paused = true
