  "res://.cinder/a2-l3-original-writer-host-v2-20261016/run-native-20261016T105426.785091Z-d87b5a2a/writer-output/public-save/checkpoint.exact.json": "6165a8a125b57e45a15e3c17af704093efe7fd4f96646973f3af489ac8183779",
