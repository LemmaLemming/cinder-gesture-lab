const LEVEL_ID: String = "A2-L3"
const SCENE_PATH: String = "res://scenes/acts/act2/a2_l3.tscn"
const CASE: String = "candidate-persistence"
const LEGACY_DIR: String = "res://.cinder/a2-l3-original-writer-host-v2-20261016/run-native-20261016T105426.785091Z-d87b5a2a/writer-output/public-save"
const EXPECTED_STAGES: Array[String] = ["fresh-initial", "fresh-save", "fresh-current", "fresh-retry", "legacy-import", "legacy-current", "legacy-retry"]
const ACCEPTED_COMMIT: String = "01f7e7bbfadf74d044d5686c9f485073e965eb4a"
const COMPANIONS: Array[String] = ["campaign.json", "campaign.json.bak", "settings.json", "settings.json.bak", "preferences.json", "preferences.json.bak"]
const SOURCE_PINS: Dictionary = {
  "res://scenes/acts/act2/a2_l3.tscn": "d4dbb7a42a75d6b017d46e406ae4c3a0a1063bc2abb3dffa25d7d0cceea5f32b",
  "res://scripts/acts/act2/ruined_house.gd": "01954a3f861ab4ebe605191f0c87a57a972b73742cff3c5b1e06125ac1deed71",
