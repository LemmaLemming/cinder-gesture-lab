"""Host-only independent closed-evidence audit. Never imports engine/dev/host controls."""
from pathlib import Path
import datetime, hashlib, json, math, os, re, stat
ROOT=Path("/Users/howardchen/Documents/ChatGPT/video game idea")
BASE=ROOT/".cinder/a2-l3-original-writer-host-v2-20261016"
PHASE=BASE/"run-native-20261016T105426.785091Z-d87b5a2a"
OUT=ROOT/".cinder/a2-l3-original-writer-actual-review-20261016"
def H(data): return hashlib.sha256(data).hexdigest()
def STRICT(data):
    def pairs(items):
        result={}
        for key,value in items:
            assert key not in result,("duplicate JSON key",key)
            result[key]=value
        return result
    def finite(token):
        value=float(token);assert math.isfinite(value),token
        return value
    return json.loads(data.decode("utf8",errors="strict"),object_pairs_hook=pairs,parse_float=finite,
                      parse_constant=lambda token: (_ for _ in ()).throw(ValueError(token)))
def J(path):return STRICT(path.read_bytes())
def STABLE(path):
    assert path.is_absolute() and path.resolve()==path,str(path)
    s=path.lstat();assert stat.S_ISREG(s.st_mode) and not stat.S_ISLNK(s.st_mode),str(path)
    data=path.read_bytes();t=path.lstat()
    assert (s.st_dev,s.st_ino,s.st_size,s.st_mode,s.st_mtime_ns)==(t.st_dev,t.st_ino,t.st_size,t.st_mode,t.st_mtime_ns)
    assert data==path.read_bytes()
    return dict(sha256=H(data),bytes=len(data),mode=format(stat.S_IMODE(s.st_mode),"04o")),data
def SAME(path,row):
    actual,data=STABLE(path)
    assert all(actual[k]==row[k] for k in actual if k in row),(str(path),actual,row)
    return actual,data
def OBS(path):
    present=os.path.lexists(path);s=path.lstat() if present else None
    regular=bool(s and stat.S_ISREG(s.st_mode));meta,_=STABLE(path) if regular else ({},None)
    return dict(exists=present,regular=regular,symlink=bool(s and stat.S_ISLNK(s.st_mode)),
                sha256=meta.get("sha256"),bytes=meta.get("bytes"),mode=format(stat.S_IMODE(s.st_mode),"04o") if s else None)
def INDEX(path):
    index=J(path/"evidence-index.json");assert index["created_after_raw_close"] is True
    for name,row in index["files"].items():
        assert not Path(name).is_absolute() and ".." not in Path(name).parts
        SAME(path/name,row)
    actual={str(p.relative_to(path)) for p in path.rglob("*") if p.is_file()}
    assert actual==set(index["files"])|{"evidence-index.json"},actual.symmetric_difference(set(index["files"])|{"evidence-index.json"})
    return dict(path=str(path.relative_to(ROOT)),index_sha256=H((path/"evidence-index.json").read_bytes()),indexed_files=len(index["files"]),physical_files=len(actual))
def EXACT(text):
    assert type(text) is str and text
    header=STRICT(text.encode())
    assert type(header) is dict and set(header)=={"api_revision","schema_version","value"}
    assert header["api_revision"]=="exact-json-1" and type(header["schema_version"]) is int and header["schema_version"]==1 and type(header["value"]) is list
    return dict(sha256=H(text.encode()),bytes=len(text.encode()),scope="Opaque literal/header only; no native Variant decode or Exact AST semantics reconstructed")
