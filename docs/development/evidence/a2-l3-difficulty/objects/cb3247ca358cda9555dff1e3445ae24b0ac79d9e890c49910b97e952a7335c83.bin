    assert J(directory/"manifest.json")==stage
    for name,text in [("attempts.exact.json",stage["exact_attempts"]),("snapshot.exact.json",fresh),("checkpoint.exact.json",fresh)]:
        _,literal=STABLE(directory/name);assert literal==text.encode()
    assert [r["name"] for r in stage["raw_files"]]==companions
    names={"attempts.exact.json","snapshot.exact.json","checkpoint.exact.json","manifest.json"}
    for row in stage["raw_files"]:
        assert type(row["present"]) is bool and row["original_path"]==native["user_root"]+row["name"]
        path=directory/row["name"]
        if row["present"]:
            meta,literal=SAME(path,row);names.add(row["name"])
            assert row["path"]=="res://"+str(path.relative_to(ROOT)) and type(row["bytes"]) is int and row["bytes"]>0
            env=STRICT(literal);assert type(env) is dict
