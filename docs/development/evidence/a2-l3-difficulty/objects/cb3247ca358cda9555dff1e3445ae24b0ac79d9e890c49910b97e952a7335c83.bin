companions=["campaign.json","campaign.json.bak","settings.json","settings.json.bak","preferences.json","preferences.json.bak"]
stagefacts=[];primary=[];last=None
assert [row["label"] for row in native["branches"]]==["initial-store","public-save"]
for stage in native["branches"]:
    label=stage["label"];directory=PHASE/"writer-output"/label
    assert type(stage["generation"]) is int and stage["generation"]>0
