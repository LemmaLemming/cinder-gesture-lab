"""Root-only host seal, then ONE original A2-L3 Challenge entrance writer."""
from pathlib import Path
import argparse
import contextlib
import datetime
import importlib.util
import json
import os
import re
import stat
import sys
import types
import uuid

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
# Execute the pinned helper source directly, avoiding an unpinned .pyc cache.
check = types.ModuleType("cinder_l3_original_native_inspect")
exec(compile((HERE / "native_inspect.py").read_bytes(), str(HERE / "native_inspect.py"), "exec"), check.__dict__)
DIAGNOSTIC = re.compile(r"^\s*(?:ERROR|WARNING|SCRIPT ERROR):|ObjectDB.*leak|Orphan.*StringName", re.I)


def save(path, value):
    data = (json.dumps(value, indent=2, allow_nan=False) + "\n").encode()
    temporary = path.with_name(path.name + ".tmp")
    with temporary.open("xb") as stream:
        stream.write(data); stream.flush(); os.fsync(stream.fileno())
    os.replace(temporary, path)


def record(path):
    present = os.path.lexists(path)
    st = path.lstat() if present else None
    regular = bool(st and stat.S_ISREG(st.st_mode))
    data = check.stable(path)[1] if regular else None
    return {"exists": present, "regular": regular, "symlink": bool(st and stat.S_ISLNK(st.st_mode)),
            "sha256": check.digest(data) if data is not None else None, "bytes": len(data) if data is not None else None,
            "mode": format(stat.S_IMODE(st.st_mode), "04o") if st else None}, data


def engine(spec):
    path = Path(spec["engine_expected"]["path"])
    row, _ = record(path)
    check.require(row == spec["engine_expected"]["record"] and os.access(path, os.X_OK), "Exact existing engine bytes/size/mode/type differ")
    return dict(row, path=str(path), retained_binary=False)


def snapshot(spec, out, label):
    names = sorted(set(spec["expected"]) | set(spec["self_files"]))
    rows = {}; retained = {}; blobs = out / "source-blobs"; blobs.mkdir(exist_ok=True)
    for name in names:
        row, data = record(ROOT / name); rows[name] = row
        if data is not None:
            target = blobs / (row["sha256"] + ".bin")
            if not target.exists():
                with target.open("xb") as stream: stream.write(data)
            check.require(check.digest(target.read_bytes()) == row["sha256"], "Retained source CAS differs")
            retained[name] = dict(row, blob=str(target.relative_to(out)))
    save(out / (label + ".json"), rows); save(out / (label + "-retention.json"), retained)
    for name, expected in spec["expected"].items():
        check.require(rows[name] == expected, "Fixed named source/size/mode/absence/type differs: " + name)
    readiness = check.strict((HERE / "READINESS.json").read_bytes())
    for name in spec["self_files"]:
        check.require(rows[name]["regular"] and not rows[name]["symlink"] and rows[name]["mode"] == "0644", "Regular0644 host input required")
    for name, expected in readiness["frozen_files"].items():
        check.require(rows[name]["sha256"] == expected, "Frozen host control changed: " + name)
    return rows


def old_seal(path):
    check.require(path.name == "seal.json" and path.parent.parent == HERE, "Closed seal from this exact capsule required")
    result = check.strict((path.parent / "result.json").read_bytes()); index = check.strict((path.parent / "evidence-index.json").read_bytes())
    check.require(result.get("closed") is True and result.get("passed") is True and type(result.get("host_return")) is int
                  and result["host_return"] == 0 and index.get("created_after_raw_close") is True, "Seal must have genuinely closed0")
    for name in ["seal.json", "result.json"]:
        meta, _ = check.stable(path.parent / name)
        check.require(index["files"][name] == {k:meta[k] for k in ["sha256", "bytes", "mode"]}, "Seal/index metadata differs")
    seal = check.strict(path.read_bytes())
    check.require(seal.get("sealed") is True and seal.get("source_phase") == str(path.parent), "Actual seal identity differs")
    return seal["sources"]


class Tee:
    def __init__(self, terminal, log): self.terminal, self.log = terminal, log
    def write(self, value): self.log.write(value); return self.terminal.write(value)
    def flush(self): self.log.flush(); self.terminal.flush()


def retain_observed(out, observation):
    records = []; destination = out / "native-retained-blobs"; destination.mkdir(exist_ok=True)
    for row in observation.get("retained", []):
        meta, data = check.stable(Path(row["path"]))
        check.require(meta == row, "Native original drift before retention")
        target = destination / (meta["sha256"] + ".bin")
        if not target.exists():
            with target.open("xb") as stream: stream.write(data)
        check.require(check.digest(target.read_bytes()) == meta["sha256"], "Native retained CAS differs")
        records.append(dict(meta, retained_blob=str(target.relative_to(out))))
    save(out / "native-literal-retention.json", records)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("phase", choices=["seal", "native"]); parser.add_argument("--seal", type=Path)
    args = parser.parse_args()
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    out = HERE / ("run-" + args.phase + "-" + stamp + "-" + uuid.uuid4().hex[:8]); out.mkdir(exist_ok=False)
    result = {"phase": args.phase, "closed": False, "passed": False, "engine_launch_attempted": False,
              "canonical_api_return": None, "owned_child_pid": None, "owned_child_return": None}
    queue = {"queued": False, "acquired": False}; code = 2; spec = None; sealed = None
    print("A2-L3 original writer output:", out, flush=True)
    with (out / "raw.log").open("x") as log, contextlib.redirect_stdout(Tee(sys.stdout, log)), contextlib.redirect_stderr(Tee(sys.stderr, log)):
        try:
            check.require((args.phase == "seal") == (args.seal is None), "Native requires one explicit successful seal; seal takes none")
            spec = check.strict((HERE / "INPUT_SPEC.json").read_bytes())
            check.require(spec["integration_root"] == str(ROOT), "Exact canonical integration root required")
            engine_before = engine(spec); save(out / "engine-before.json", engine_before)
            current = snapshot(spec, out, "preflight-observed")
            if args.phase == "seal":
                sealed = snapshot(spec, out, "sources-at-seal")
                check.require(sealed == current, "Source drift during host-only seal")
                save(out / "seal.json", {"sealed": True, "source_phase": str(out), "sources": sealed, "scope": spec["scope"]})
            else:
                selected = args.seal.absolute(); sealed = old_seal(selected)
                check.require(current == sealed, "Named inputs differ from explicit closed seal")
                save(out / "selected-seal.json", {"path": str(selected), "sha256": check.digest(selected.read_bytes())})
                module_spec = importlib.util.spec_from_file_location("cinder_a2_l3_original_writer_dev", ROOT / "scripts/dev/dev.py")
                check.require(module_spec is not None and module_spec.loader is not None, "Actual canonical dev module required")
                dev = importlib.util.module_from_spec(module_spec); sys.modules[module_spec.name] = dev
                old_bytecode = sys.dont_write_bytecode
                try:
                    sys.dont_write_bytecode = True; module_spec.loader.exec_module(dev)
                finally: sys.dont_write_bytecode = old_bytecode
                environ = dict(os.environ); environ.update({"CINDER_GODOT": spec["engine_expected"]["path"], "CINDER_CANONICAL_ROOT": str(ROOT), "PYTHONDONTWRITEBYTECODE": "1"})
                context = dev.ProjectContext(root=ROOT, environ=environ)
                check.require(context.root == ROOT and context.canonical_root == ROOT, "Canonical project/context differs")
                binary = dev.resolve_godot(context)
                check.require(str(binary) == spec["engine_expected"]["path"], "Resolved engine path differs")
                writer_output = out / "writer-output"
                check.require(not writer_output.exists(), "Native output leaf must be absent")
                user_args = ["--case=original-challenge-entrance", "--fixture-sha256=" + spec["fixture_sha256"],
                             "--output-root=res://" + str(writer_output.relative_to(ROOT))]
                command = [str(binary), "--path", str(ROOT), "--headless", "--log-file", str(out / "engine.log"),
                           "--script", "res://" + spec["fixture"], "--"] + user_args
                save(out / "command.json", {"argv": command, "user_arguments": user_args, "environment_overrides": {k:environ[k] for k in ["CINDER_GODOT", "CINDER_CANONICAL_ROOT", "PYTHONDONTWRITEBYTECODE"]},
                                           "timeout_after_lock_seconds": 180, "native_store": spec["userdata_contract"], "canonical_api": "dev.godot_lock/run_validation"})
                check.require(snapshot(spec, out, "sources-before-queue") == sealed, "Inputs changed before queue")
                queue.update({"queued": True, "lock_path": str(dev.shared_lock_path(ROOT))}); save(out / "queue.json", queue)
                try:
                    with dev.godot_lock(ROOT) as lock_fd:
                        queue["acquired"] = True; save(out / "queue.json", queue)
                        check.require(snapshot(spec, out, "sources-at-lock") == sealed and engine(spec) == engine_before, "Inputs/engine changed at lock")
                        owned = []; real_popen = dev.subprocess.Popen
                        def observe_popen(argv, *pos, **kw):
                            check.require(argv == command and not owned, "Exactly one canonical owned validation child permitted")
                            child = real_popen(argv, *pos, **kw); owned.append(child)
                            result["owned_child_pid"] = child.pid; save(out / "result.json", result)
                            return child
                        result["engine_launch_attempted"] = True; save(out / "result.json", result)
                        dev.subprocess.Popen = observe_popen
                        try:
                            result["canonical_api_return"] = dev.run_validation(command, context, lock_fd, 180, detect_godot_errors=True)
                        finally:
                            dev.subprocess.Popen = real_popen
                            if owned and owned[0].poll() is None:
                                result["host_closed_only_its_own_child_after_api_unwind"] = True
                                dev.stop_validation(owned[0])
                            result["owned_child_return"] = owned[0].poll() if owned else None
                            result["owned_child_closed_before_lock_release"] = len(owned) == 1 and result["owned_child_return"] is not None
                            save(out / "result.json", result)
                        check.require(result["owned_child_closed_before_lock_release"], "Actual owned child closure required")
                        log.flush()
                        result["native_observation"] = check.observe(out, ROOT, spec, (out / "raw.log").read_text(),
                                                                    result["canonical_api_return"], result["owned_child_pid"], result["owned_child_return"])
                        save(out / "native-observation.json", result["native_observation"])
                        retain_observed(out, result["native_observation"])
                        check.require(snapshot(spec, out, "sources-after-child") == sealed, "Source drift after owned child")
                        check.require(engine(spec) == engine_before, "Engine drift after owned child")
                        check.require(result["native_observation"]["functional_pass"], "Actual native writer report/rows/raw custody failed or incomplete")
                        all_raw = (out / "raw.log").read_text()
                        all_engine = (out / "engine.log").read_text(errors="replace") if (out / "engine.log").is_file() else ""
                        check.require(not any(DIAGNOSTIC.search(line) for line in (all_raw + "\n" + all_engine).splitlines()), "Actual raw/engine diagnostic remains NONCLEAN; no rerun-for-green")
                finally:
                    if queue["acquired"]: queue["lock_context_released"] = True; save(out / "queue.json", queue)
            result["passed"] = True; code = 0
        except KeyboardInterrupt:
            result["error"] = "Interrupted; only canonical owned child cleanup is permitted"; code = 130
        except Exception as error:
            result["error"] = str(error); print("A2-L3 original writer host failure:", error, flush=True)
        finally:
            if spec is not None:
                try:
                    closed = snapshot(spec, out, "sources-at-runner-close")
                    check.require(sealed is None or closed == sealed, "Source drift at runner close")
                    save(out / "engine-after.json", engine(spec))
                except Exception as error:
                    result["close_custody_error"] = str(error); result["passed"] = False; code = 2
            log.flush()
            result.update({"closed": True, "host_return": code, "raw_diagnostics": [line for line in (out / "raw.log").read_text().splitlines() if DIAGNOSTIC.search(line)],
                           "scope": "One actual original entrance writer only. Native rows/API/owned Popen vs Host diagnostics retained separately; no historical495/Stage/held/candidate/earned route proof."})
            save(out / "result.json", result); save(out / "queue.json", queue)
            print("A2-L3 original writer host CLOSED code=" + str(code), flush=True)
    files = {}
    for path in sorted(out.rglob("*")):
        if path.is_file() and path != out / "evidence-index.json":
            row, _ = check.stable(path); files[str(path.relative_to(out))] = {k:row[k] for k in ["sha256", "bytes", "mode"]}
    save(out / "evidence-index.json", {"created_after_raw_close": True, "files": files})
    return code


if __name__ == "__main__":
    raise SystemExit(main())
