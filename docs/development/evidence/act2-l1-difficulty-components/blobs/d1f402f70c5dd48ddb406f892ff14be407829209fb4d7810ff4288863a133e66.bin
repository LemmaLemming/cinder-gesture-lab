"""Six explicitly CLOSED component originals; private incremental digest pack."""
from pathlib import Path, PurePosixPath
import datetime
import hashlib
import json
import stat
import struct

HERE = Path(__file__).resolve().parent
BASE = HERE.parent
ROOT = BASE.parents[1]
PUBLIC = "docs/development/evidence/act2-l1-difficulty-components/"
BASE_PUBLIC = "docs/development/evidence/act2-l1-difficulty-root-base/"
BASE_PACK = HERE / "pack-base-20261016T053723.156263Z/pack"
BASE_MANIFEST_SHA = "8b15e8cd1900082a33ac3077e3aeeecd118ef9804dbd4969c14381dc4c47b628"
PHASES = [
    "validation-successor-v1/run-native-pair-20261016T053202.305090Z-3936fff9",
    "validation-successor-v2/run-seal-pure-20261016T054012.513911Z-583324c9",
    "validation-successor-v2/run-native-pair-20261016T054019.309216Z-f2a7a08c",
    "validation-successor-v2/run-native-pair-20261016T054131.693059Z-be4a7c1f",
    "validation-successor-v2/run-native-pair-20261016T054314.476251Z-061d5270",
    "validation-successor-v2/run-native-pair-20261016T054333.360802Z-74387c95",
]
EXTRAS = {
    "component-prepare": ["SOURCE_INPUTS.json", "declared_common_current.gd.txt", "README.md", "READINESS.json", "declared_common_old.gd.txt", "act2_l1_arrangement_component.gd.txt", "original-cd383/act2_l1_arrangement_component.gd.txt", "strict-source-b1a3/act2_l1_arrangement_component.gd.txt", "report-v2/report-only.patch.txt", "report-v2/README.md", "report-v2/READINESS.json", "report-v2/act2_l1_arrangement_component.gd.txt", "report-v2/REPORT_CONTRACT.json"],
    "component-decision-review": ["REVIEW.json", "REVIEW.md", "FOLLOWUP_3a25f411.json", "FOLLOWUP_3a25f411.md", "geometry-fix/SOURCE_DIFF.patch", "geometry-fix/README.md", "geometry-fix/act2_l1_arrangement_component.gd.txt", "geometry-fix/REVIEW.json", "actual-f2a7a08c/REVIEW.json", "actual-f2a7a08c/REVIEW.md", "actual-f2a7a08c/CUSTODY_SUPPLEMENT.json", "actual-be4a7c1f/REVIEW.json", "actual-be4a7c1f/REVIEW.md"],
    "root-test-selection": ["COMPONENT_SELECTION.json", "COMPONENT_PATH_FIX.json", "component-path-fix-v1/original-94d82eab.gd.txt", "component-path-fix-v1/successor.gd.txt", "COMPONENT_GEOMETRY_FIX.json", "component-geometry-fix-v2/original-3a25f411.gd.txt"],
    "validation-successor-v1": ["INPUT_SPEC.json", "run.py", "SOURCE_INPUTS.json", "README.md", "READINESS.json", "PREPARATION_STATUS.json"],
    "validation-successor-v2": ["INPUT_SPEC.json", "run.py", "SOURCE_INPUTS.json", "README.md", "READINESS.json"],
    "root-verification": ["BASE_PACK_REVIEW.json"],
}


def require(ok, reason):
    if not ok:
        raise ValueError(reason)


def read(path):
    return json.loads(path.read_text(), parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))


def digest(data):
    return hashlib.sha256(data).hexdigest()


def regular(path):
    require(path.is_file() and not path.is_symlink(), "Regular original required: " + str(path))
    return path.read_bytes()


def encode(value):
    return (json.dumps(value, indent=2, allow_nan=False) + "\n").encode()


def safe(name):
    require(type(name) is str, "String path required")
    p = PurePosixPath(name)
    require(not p.is_absolute() and ".." not in p.parts and str(p) == name and name not in ("", "."), "Safe relative path required")
    return name


def meta(path):
    data = regular(path)
    return {"sha256": digest(data), "bytes": len(data), "mode_octal": format(stat.S_IMODE(path.stat().st_mode), "04o")}


def main():
    base_manifest_path = BASE_PACK / (BASE_PUBLIC + "PUBLIC_COPY_MANIFEST.json")
    require(digest(regular(base_manifest_path)) == BASE_MANIFEST_SHA, "Reviewed immutable base manifest required")
    base_manifest = read(base_manifest_path)
    base_digests = {row["sha256"]: name for name, row in base_manifest["files"].items() if name.startswith(BASE_PUBLIC + "blobs/")}
    selected, aliases, phases = {}, [], []
    def select(path, role):
        name = path.relative_to(ROOT).as_posix()
        data, row = regular(path), meta(path)
        row["role"] = role
        if name in selected:
            require(selected[name][0] == data and selected[name][1]["mode_octal"] == row["mode_octal"], "Original changed while selecting")
        else:
            selected[name] = (data, row)
        return name
    for phase_name in PHASES:
        phase = BASE / phase_name
        result = read(phase / "result.json")
        require(result.get("closed") is True and type(result.get("passed")) is bool and type(result.get("runner_return_code")) is int, "Explicit CLOSED original required")
        index = read(phase / "evidence-index.json")
        require(index.get("created_after_raw_close") is True, "Original after-raw-close index required")
        physical = {p.relative_to(phase).as_posix() for p in phase.rglob("*") if p.is_file()}
        require(physical == set(index["files"]) | {"evidence-index.json"}, "Original exact phase physical/index whitelist differs")
        for name, row in index["files"].items():
            data = regular(phase / safe(name))
            require(digest(data) == row["sha256"] and len(data) == row["bytes"], "Original indexed hash/size mismatch")
        members = {name: select(phase / name, "actual original CLOSED component artifact; source/report/failed status retained") for name in sorted(physical)}
        for name in sorted(n for n in physical if n.endswith("-retention.json") and n != "native-report-retention.json"):
            retention = read(phase / name)
            observation_name = name.replace("-retention.json", ".json")
            observed = read(phase / observation_name)
            require(set(retention) == {k for k, v in observed.items() if v is not None}, "Original source observation/retention keyset differs")
            for logical, value in observed.items():
                row = {"phase": phase_name, "original_observation_relative_path": members[observation_name], "original_retention_relative_path": members[name], "original_source_relative_path": logical, "present": value is not None}
                if value is not None:
                    original = members[safe(retention[logical]["blob"])]
                    data, m = selected[original]
                    require(m["sha256"] == value == retention[logical]["sha256"] and m["bytes"] == retention[logical]["bytes"], "Exact original retained source join differs")
                    row.update({"original_retained_blob_relative_path": original, "sha256": value, "bytes": m["bytes"]})
                aliases.append(row)
        report = read(phase / "native-report.json") if "native-report.json" in physical else None
        summary = {"phase": phase_name, "original_index_relative_path": members["evidence-index.json"], "original_result_relative_path": members["result.json"], "closed": True, "recorded_passed": result["passed"], "runner_return_code": result["runner_return_code"], "canonical_return_code": result.get("canonical_return_code"), "native_report_present": report is not None, "original_file_count_including_index": len(members), "recorded_raw_diagnostics": result.get("raw_diagnostics", [])}
        if report is not None:
            rows = report["rows"]
            require(report["checks"] == len(rows) and all(row["check"] == i + 1 and type(row["ok"]) is bool for i, row in enumerate(rows)), "Actual consecutive structured native rows required")
            false = [row for row in rows if not row["ok"]]
            require(len(false) == report["failures"] and (report["first_failure"] == false[0] if false else report["first_failure"] == {}), "Actual first failure/row counts differ")
            require(report["source_before"] == report["source_after"], "Native selected source maps differ")
            atlock = read(phase / "sources-at-lock.json")
            require(all(uri.startswith("res://") and atlock.get(uri[6:]) == value for uri, value in report["source_before"].items()), "Actual native/at-lock source subset mismatch")
            summary.update({"original_report_relative_path": members["native-report.json"], "actual_report_control_fields": {k: report.get(k) for k in ("checks", "failures", "complete", "success", "first_failure", "selector")}, "native_limits": report["limits"]})
        if phase_name.endswith("3936fff9"):
            require(report["checks"] == 28 and report["failures"] == 1 and not report["complete"] and not result["passed"], "Original28/1 must stay incomplete failed")
            summary["qualification"] = "Native28/1 old-left geometry compound assertion; incomplete, original CA diagnostic retained. No clean pass or inferred gameplay failure cause."
        elif phase_name.endswith("f2a7a08c"):
            require(report["checks"] == 125 and report["failures"] == 0 and report["complete"] and report["success"] and result["canonical_return_code"] == 0 and result["runner_return_code"] == 2 and not result["passed"], "Functional125/0 host2 must remain NONCLEAN")
            summary["qualification"] = "Actual complete native125/0, canonical child0; host CLOSED2/NONCLEAN solely preserved CA/noErr diagnostic. Never relabeled clean."
        elif phase_name.endswith("be4a7c1f"):
            require(report["checks"] == 29 and report["failures"] == 1 and not report["complete"] and not result["passed"], "Original short-slow29/1 must remain failed")
            summary["qualification"] = "Actual short-slow-right29/1; source/cycle/lease timing guard refusal retained, no corrected-left or successful component credit."
        elif phase_name.endswith("061d5270"):
            require(report is None and result["canonical_return_code"] == -6 and result["runner_return_code"] == 2 and "engine.log" not in physical, "Original launch abort must remain absent native/engine log")
            summary["qualification"] = "Graphical launch abort -6; original no engine.log/native report/PNG/typed observation. No native or visual execution claim."
        elif phase_name.endswith("74387c95"):
            require(report["checks"] == 62 and report["failures"] == 0 and report["complete"] and report["success"] and result["runner_return_code"] == 0 and result["passed"], "Actual desktop portrait62/0 complete required")
            summary["qualification"] = "Actual desktop native62/0, paused portrait only; host packaging does not add firsthand pixel inspection or graphical combat completion."
        phases.append(summary)
    for folder, names in EXTRAS.items():
        for name in names:
            select(BASE / folder / name, "private preparation/source correction/independent or Root review snapshot, historical status retained; not execution repin")
    select(Path(__file__).resolve(), "specific incremental archive helper, no engine")
    portrait_phase = BASE / PHASES[-1]
    report = read(portrait_phase / "native-report.json")
    portrait = report["receipts"]["current-portrait-left"]["portrait"]
    image = regular(portrait_phase / "changed-common.png")
    require(image[:8] == b"\x89PNG\r\n\x1a\n" and image[12:16] == b"IHDR", "Original PNG header required")
    dimensions = list(struct.unpack(">II", image[16:24]))
    require(dimensions == [540, 1170] and digest(image) == portrait["image_sha256"], "Original actual image dimensions/hash join")
    before = regular(portrait_phase / "portrait-before.var")
    after = regular(portrait_phase / "portrait-after.var")
    require(len(before) > 0 and before == after and digest(before) == portrait["typed_before_sha256"] == portrait["typed_after_sha256"], "Actual nonempty typed before/after equality and report hashes")
    require(portrait["before"] == portrait["after"] and portrait["camera_error"] == "", "Native reported paused state equality/current containment")
    portrait_summary = {"image_sha256": digest(image), "dimensions": dimensions, "image_bytes": len(image), "typed_raw_sha256": digest(before), "typed_raw_bytes_each": len(before), "typed_raw_nonempty_byte_equal": True, "JSON_observations_before_after_equal": True, "reported_camera_error": "", "scope": "Verified original image header/hash and typed raw identity only. No host .var engine decoding or firsthand optical judgment. Parent Root reports personal pixel inspection separately."}
    output = HERE / ("pack-components-" + datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ"))
    output.mkdir(exist_ok=False)
    pack = output / "pack"
    files, originals, reused, new = {}, {}, {}, {}
    def put(name, data):
        require(safe(name).startswith(PUBLIC), "Fixed private supplement prefix required")
        path = pack / name
        path.parent.mkdir(parents=True, exist_ok=True)
        if path.exists():
            require(regular(path) == data, "Prepared digest/path conflict")
        else:
            with path.open("xb") as f: f.write(data)
        path.chmod(0o644)
        files[name] = {"sha256": digest(data), "bytes": len(data), "mode_octal": "0644"}
    def storage(data, row):
        value = row["sha256"]
        if value in base_digests:
            destination = base_digests[value]
            original = BASE_PACK / destination
            expected = base_manifest["files"][destination]
            require(regular(original) == data and meta(original) == expected, "Referenced immutable base digest differs")
            reused[value] = {"repository_storage_path": destination, **expected}
            return destination
        destination = PUBLIC + "blobs/" + value + ".bin"
        put(destination, data)
        new[value] = {"repository_storage_path": destination, "bytes": row["bytes"]}
        return destination
    put(PUBLIC + ".gdignore", b"")
    for name, (data, row) in selected.items():
        originals[name] = {**row, "repository_storage_path": storage(data, row)}
    for row in aliases:
        if row["present"]:
            row["repository_storage_path"] = originals[row["original_retained_blob_relative_path"]]["repository_storage_path"]
    put(PUBLIC + "original-paths.json", encode({"schema_version": 1, "scope": "Byte-exact original paths/hash/size/modes map to supplement or verified immutable base CAS. Original indices and historical paths stay opaque unchanged; old physical paths are not claimed live here.", "files": originals}))
    put(PUBLIC + "source-observation-aliases.json", encode({"schema_version": 1, "scope": "Derived explicit original observation/retention/source relocation joins only; no historical repin.", "aliases": aliases}))
    put(PUBLIC + "BASE_CAS_REFERENCE.json", encode({"schema_version": 1, "required_base_manifest_repository_path": BASE_PUBLIC + "PUBLIC_COPY_MANIFEST.json", "required_base_manifest_sha256": BASE_MANIFEST_SHA, "reused_blob_count": len(reused), "reused_blobs": reused, "scope": "This is an incremental supplement, not standalone storage. Every referenced base blob was verified against original bytes and reviewed immutable manifest; original files are not duplicated."}))
    index = {"schema_version": 1, "kind": "a2-l1-six-closed-component-originals-incremental-evidence", "actual_closed_phases": len(phases), "phases": phases, "original_paths": len(originals), "unique_new_CAS_blobs": len(new), "unique_reused_base_CAS_blobs": len(reused), "source_aliases": len(aliases), "portrait": portrait_summary, "active_or_unexecuted_v3_included": False, "scope": "Exactly six named CLOSED component originals; preserves failures, host diagnostic status, absent launch artifacts and original paused PNG/typed bytes. Root may add one explicitly closed left successor separately. No new native run, acceptance, full-parent save authority, whole route, first-person optical review or global closure claim."}
    put(PUBLIC + "index.json", encode(index))
    put(PUBLIC + "README.md", ("# A2-L1 closed component evidence\n\nThis incremental six-phase pack preserves actual28/1, complete native125/0 with host CLOSED2/NONCLEAN CA diagnostic, short-slow-right29/1, graphical launch -6 with absent native/engine/PNG, and desktop paused portrait62/0. The sixth phase is the v2 host seal. No v3 run/result is included.\n\nOne new digest pool plus verified immutable base CAS stores originals without duplicate base blobs. original-paths.json maps original path/hash/size/mode to exact storage; source-observation-aliases.json supplies derived joins. Original maps/indexes retain old physical paths and are not rewritten or asserted live in the new layout. BASE_CAS_REFERENCE.json pins the required base manifest and reused blobs.\n\nThe actual540x1170 PNG and nonempty byte-identical typed before/after are retained. Root separately reports personal pixel inspection; packaging supplies no firsthand optics, graphical combat completion, parent snapshot/route, balance, performance or acceptance credit. Later explicitly closed left evidence must be additive.\n").encode())
    manifest_name = PUBLIC + "PUBLIC_COPY_MANIFEST.json"
    put(manifest_name, encode({"schema_version": 1, "status": "PRIVATE_COMPONENT_SUPPLEMENT_READY_FOR_ROOT_REVIEW_ONLY", "file_count_excluding_this_manifest": len(files), "file_count_including_this_manifest": len(files) + 1, "bytes_excluding_this_manifest": sum(x["bytes"] for x in files.values()), "required_base_manifest_sha256": BASE_MANIFEST_SHA, "self_repository_path": manifest_name, "files": dict(files)}))
    for name, expected in files.items():
        require(meta(pack / name) == expected, "Prepared exact file/mode verification failed")
    for original, (data, row) in selected.items():
        require(regular(ROOT / original) == data and meta(ROOT / original)["mode_octal"] == row["mode_octal"], "Original changed during preparation")
    for row in reused.values():
        require(meta(BASE_PACK / row["repository_storage_path"]) == {k:row[k] for k in ("sha256", "bytes", "mode_octal")}, "Base reference changed during preparation")
    (output / "PUBLICATION_PATHS.txt").write_text("\n".join(sorted(files)) + "\n")
    (output / "PUBLICATION_PATHS.nul").write_bytes(b"".join(name.encode() + b"\0" for name in sorted(files)))
    closure = {"schema_version": 1, "status": "EXACT_PRIVATE_COMPONENT_SUPPLEMENT_VERIFIED", "closed_phases": len(phases), "original_paths": len(originals), "source_aliases": len(aliases), "new_CAS_blobs": len(new), "reused_base_CAS_blobs": len(reused), "publication_files": len(files), "publication_bytes": sum(x["bytes"] for x in files.values()), "manifest_sha256": files[manifest_name]["sha256"], "index_sha256": files[PUBLIC + "index.json"]["sha256"], "base_manifest_sha256": BASE_MANIFEST_SHA, "no_engine_Git_publiccopy_or_native_acceptance_claim": True}
    (output / "PREPARATION_CLOSURE.json").write_bytes(encode(closure))
    print(json.dumps({"private_output": str(output), **closure}, indent=2))


if __name__ == "__main__":
    main()
