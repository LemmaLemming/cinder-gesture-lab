"""Exact three CLOSED Root phases; host-only digest pack, no engine/public copy."""
from pathlib import Path,PurePosixPath
import json,hashlib,stat,datetime
HERE=Path(__file__).resolve().parent
BASE=HERE.parent
ROOT=BASE.parents[1]
PUBLIC='docs/development/evidence/act3-l3-difficulty-root/'
PHASES=['run-seal-20261016T062126.380125Z-e5dc42b9','run-native-20261016T062131.150817Z-acd51c71','run-native-20261016T062213.958167Z-0cf3f702']
EXTRAS={'root-verification':['run.py','INPUT_SPEC.json','SOURCE_INPUTS.json','README.md','SELF_REVIEW.json','READINESS.json','ROOT_NATIVE_REVIEW.json'],'registration-prepare':['READINESS.json','README.md','SOURCE_INPUTS.json','act3_l3_registration_smoke.before.gd.txt','act3_l3_registration_smoke.gd.txt','act3_l3_registration_smoke.patch.txt'],'root-promotion':['ROOT_PROMOTION.json','DOCUMENT_SUPPLEMENT.json','ROOT_VISUAL_REVIEW.json','promote.py'],'review':['REVIEW.json','REVIEW.md','PRECANONICAL_EVIDENCE_REVIEW.json']}
def need(ok,why):
 if not ok:raise ValueError(why)
def read(p):return json.loads(p.read_text())
def data(p):
 need(p.is_file() and not p.is_symlink(),'Regular original required '+str(p));return p.read_bytes()
def sha(b):return hashlib.sha256(b).hexdigest()
def meta(p):
 b=data(p);return {'sha256':sha(b),'bytes':len(b),'mode_octal':format(stat.S_IMODE(p.stat().st_mode),'04o')}
def enc(x):return (json.dumps(x,indent=2,allow_nan=False)+'\n').encode()
def safe(n):
 p=PurePosixPath(n);need(not p.is_absolute() and '..' not in p.parts and str(p)==n,'Safe relative path');return n
def main():
 selected={};aliases=[];phases=[]
 def select(p,role):
  n=p.relative_to(ROOT).as_posix();b=data(p);m=meta(p);m['role']=role
  if n in selected:need(selected[n][0]==b and selected[n][1]==m,'Selection changed')
  selected[n]=(b,m);return n
 for name in PHASES:
  p=BASE/'root-verification'/name;idx=read(p/'evidence-index.json');result=read(p/'result.json');need(result['closed'] is True and idx['created_after_raw_close'] is True,'Original CLOSED required');physical={q.relative_to(p).as_posix() for q in p.rglob('*') if q.is_file()};need(physical==set(idx['files'])|{'evidence-index.json'},'Exact original phase physical/index whitelist')
  for n,m in idx['files'].items():need(sha(data(p/safe(n)))==m['sha256'] and len(data(p/n))==m['bytes'],'Original indexed source differs')
  members={n:select(p/n,'Original CLOSED phase artifact; historical bytes/status/path untouched') for n in sorted(physical)}
  for n in sorted(x for x in physical if x.endswith('-retention.json') and x!='native-report-retention.json'):
   retention=read(p/n);observation=n.replace('-retention.json','.json');observed=read(p/observation);need(set(retention)==set(observed),'Source retention keyset')
   for logical,digest in observed.items():
    m=retention[logical];blob=members[safe(m['blob'])];need(selected[blob][1]['sha256']==digest==m['sha256'] and selected[blob][1]['bytes']==m['bytes'],'Original source/CAS join');aliases.append({'phase':name,'original_observation_path':members[observation],'original_retention_path':members[n],'original_source_path':logical,'sha256':digest,'bytes':m['bytes'],'original_blob_path':blob})
  row={'phase':name,'index_sha256':sha(data(p/'evidence-index.json')),'original_result_path':members['result.json'],'closed':True,'passed':result['passed'],'runner_return_code':result['runner_return_code'],'canonical_return_code':result['canonical_validation_return_code'],'diagnostics':result['raw_diagnostic_lines'],'original_file_count_including_index':len(physical)}
  if (p/'native-report.json').exists():
   report=read(p/'native-report.json');row['actual_native_controls']={k:report[k] for k in ['checks','failures','first_failure','complete','success','kind']};row['native_report_sha256']=sha(data(p/'native-report.json'))
  phases.append(row)
 for folder,names in EXTRAS.items():
  for n in names:select(BASE/folder/n,'Named preparation/promotion/independent/visual/native review snapshot; original status retained')
 select(Path(__file__),'Exact private host-only packaging helper')
 promotion=read(BASE/'root-promotion/ROOT_PROMOTION.json');owner={p:m for p,m in promotion['promoted'].items() if p!='tests/act3_l3_registration_smoke.gd'} if isinstance(promotion['promoted'],dict) else None
 need(owner is not None,'Promotion exact path/hash map required')
 output=HERE/('pack-'+datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ'));output.mkdir(exist_ok=False);pack=output/'pack';files={};originals={};blobs=set()
 def put(n,b):
  need(safe(n).startswith(PUBLIC),'Exact destination prefix');p=pack/n;p.parent.mkdir(parents=True,exist_ok=True)
  if p.exists():need(data(p)==b,'CAS collision')
  else:p.write_bytes(b)
  p.chmod(0o644);files[n]=meta(p)
 put(PUBLIC+'.gdignore',b'')
 for n,(b,m) in selected.items():
  dest=PUBLIC+'blobs/'+m['sha256']+'.bin';put(dest,b);blobs.add(dest);originals[n]={**m,'repository_storage_path':dest}
 for a in aliases:a['repository_storage_path']=originals[a['original_blob_path']]['repository_storage_path']
 put(PUBLIC+'original-paths.json',enc({'schema_version':1,'files':originals,'scope':'Original mode/hash/size/path maps; archive CAS is0644, original modes explicitly retained. Original evidence opaque paths/indexes unchanged, no historical repin.'}))
 put(PUBLIC+'source-observation-aliases.json',enc({'schema_version':1,'aliases':aliases}))
 put(PUBLIC+'OWNER_ARCHIVE_REFERENCE.json',enc({'schema_version':1,'source_commit':promotion['submitted_commit'],'promotion_receipt_sha256':sha(data(BASE/'root-promotion/ROOT_PROMOTION.json')),'already_promoted_owner_path_count':len(owner),'paths':owner,'scope':'Receipt-derived reference to separately promoted owner originals, no duplicate copy or new broad bank verification. Owner historical failures/whitespace remain immutable; clean Root native diagnostics do not assert all historical archived text whitespace-clean.'}))
 index={'schema_version':1,'kind':'a3-l3-root-three-closed-short-registration-phases','phases':phases,'unique_CAS_blobs':len(blobs),'original_paths':len(originals),'source_aliases':len(aliases),'scope':'Host-only portable Root evidence. Original sandbox10/1 incomplete Save-directory refusal/CA remains FAILED; scoped escalated clean24/0 CLOSED0 retained. No owner archive duplication/new native run/whole-route/portrait/acceptance claim.'}
 put(PUBLIC+'index.json',enc(index))
 put(PUBLIC+'README.md',b'# A3-L3 Root short registration evidence\n\n[index.json](index.json) records exactly three CLOSED phases: host seal, sandbox native10/1 incomplete Save-directory refusal plus CA diagnostic, and scoped escalated clean native24/0 CLOSED0. [original-paths.json](original-paths.json) maps byte-exact originals including modes into deduplicated CAS; [source-observation-aliases.json](source-observation-aliases.json) preserves original95-input custody joins. Original reports/raw/indices/results/queues/source maps remain unchanged.\n\nTwo clean native receipts retain whole initial snapshot/checkpoint/session and format2 Store1-to-2 generations, exact prior primary backup, and nine replaced native recipients. Entry/prerequisite/public entranceRetry/quiet cleanup only; no owner Challenge/legacy/combat/route/portrait repeat or new acceptance. Original674 owner paths are referenced separately in [OWNER_ARCHIVE_REFERENCE.json](OWNER_ARCHIVE_REFERENCE.json), not recopied. Clean Root runtime diagnostics do not imply immutable owner archives are whitespace-clean. Root visual record is prior personal pixel evidence, not new inspection by packaging.\n')
 manifest=PUBLIC+'PUBLIC_COPY_MANIFEST.json';put(manifest,enc({'schema_version':1,'status':'PRIVATE_READY_FOR_ROOT_REVIEW_ONLY','file_count_excluding_this_manifest':len(files),'file_count_including_this_manifest':len(files)+1,'self_repository_path':manifest,'files':dict(files)}))
 for n,m in files.items():need(meta(pack/n)==m,'Pack exact hash/size/mode')
 for n,(b,m) in selected.items():need(data(ROOT/n)==b and meta(ROOT/n)=={k:m[k] for k in ['sha256','bytes','mode_octal']},'Original changed')
 for link in ['index.json','original-paths.json','source-observation-aliases.json','OWNER_ARCHIVE_REFERENCE.json']:need((pack/PUBLIC/link).is_file(),'README link absent')
 (output/'PUBLICATION_PATHS.txt').write_text('\n'.join(sorted(files))+'\n');(output/'PUBLICATION_PATHS.nul').write_bytes(b''.join(n.encode()+b'\0' for n in sorted(files)))
 closure={'status':'EXACT_PRIVATE_ROOT_PACK_READY','private_pack':str(pack),'publication_files':len(files),'publication_bytes':sum(m['bytes'] for m in files.values()),'manifest_sha256':files[manifest]['sha256'],'index_sha256':files[PUBLIC+'index.json']['sha256'],'unique_CAS_blobs':len(blobs),'original_paths':len(originals),'source_aliases':len(aliases),'closed_phases':3,'README_links_verified':True,'no_engine_Git_publication':True};(output/'PREPARATION_CLOSURE.json').write_bytes(enc(closure));print(json.dumps(closure,indent=2))
if __name__=='__main__':main()
