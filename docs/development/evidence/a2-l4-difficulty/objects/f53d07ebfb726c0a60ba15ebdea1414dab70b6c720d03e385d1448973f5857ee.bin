+func _persist_precleanup(boundary: String) -> bool:
+	_precleanup_serial += 1
+	var stem: String = "pre-cleanup-%02d" % _precleanup_serial
+	var path: String = _report_path.get_base_dir().path_join(stem + ".bin")
+	var summary_path: String = _report_path.get_base_dir().path_join(stem + ".json")
+	# Seal explicit binding observations while every current recipient is live.
+	var captured: Dictionary = _snapshot_open_component()
+	var payload: Dictionary = {
+		"api_revision": "TEST-a2-l4-pre-cleanup-trace-1", "boundary": boundary,
+		"cleanup_status": "pending; this artifact makes no normal-cleanup claim",
+		"source_sha256": FileAccess.get_sha256(get_script().resource_path),
+		"embedded_host_sha256": FOCUS_HOST_SHA256, "embedded_game_sha256": FOCUS_GAME_SHA256,
+		"source_observations": _source_observations.duplicate(true),
+		"closed_components": _components.duplicate(true), "open_component": captured,
+		"checks_detail": _rows.duplicate(true), "checks": _checks, "failures": _failures,
+		"actual_verdict_at_boundary": _verdict, "actual_reason_at_boundary": _reason,
+		"original_actual_success": _original_success, "candidate_actual_success": _candidate_success,
+		"counterfactual_intersects": _counterfactual_intersects,
+		"campaign_or_policy_acceptance_claimed": false,
+		"evidence_error_at_boundary": _evidence_error,
+		"earlier_immutable_receipts": _precleanup_receipts.duplicate(true),
+	}
+	var receipt: Dictionary = {"accepted": false, "boundary": boundary, "reason": "owned output path unavailable"}
+	if _report_owned and not FileAccess.file_exists(path) and not FileAccess.file_exists(summary_path):
+		var bytes: PackedByteArray = var_to_bytes(payload)
+		if bytes.size() <= 128 * 1024 * 1024:
+			receipt = _write_raw(path, bytes)
+			receipt["boundary"] = boundary
+		else:
+			receipt = {"accepted": false, "boundary": boundary, "reason": "full pre-cleanup trace exceeded 128MiB; no paths trimmed", "bytes": bytes.size()}
+	var summary: Dictionary = {
+		"api_revision": "TEST-a2-l4-pre-cleanup-summary-1", "boundary": boundary,
+		"cleanup_pending": true, "normal_cleanup_completed": false,
+		"campaign_or_policy_acceptance_claimed": false,
+		"actual_verdict_at_boundary": _verdict, "actual_reason_at_boundary": _reason,
+		"original_actual_success": _original_success, "candidate_actual_success": _candidate_success,
+		"checks": _checks, "failures": _failures, "raw_native_trace": receipt,
+	}
+	var summary_ok: bool = false
+	if _report_owned and not FileAccess.file_exists(summary_path):
+		var wire: String = JSON.stringify(summary, "\t", true, true) + "\n"
+		var file: FileAccess = FileAccess.open(summary_path, FileAccess.WRITE)
+		if file != null:
+			file.store_string(wire); file.flush()
+			var io_ok: bool = file.get_error() == OK
+			file.close()
+			summary_ok = io_ok and FileAccess.get_file_as_string(summary_path) == wire and FileAccess.get_sha256(summary_path) == wire.sha256_text()
+			receipt["summary"] = {"path": summary_path, "sha256": wire.sha256_text(), "accepted": summary_ok}
+	var accepted: bool = receipt.get("accepted", false) and summary_ok
+	_precleanup_all_ok = _precleanup_all_ok and accepted
+	_precleanup_receipts.append(receipt)
+	if not accepted:
+		_lifecycle_error = "Immutable pre-cleanup native trace/summary could not be safely persisted; actual mechanical verdict remains recorded separately"
+		push_error("A2-L4 pre-cleanup evidence persistence failed; no success or further arm work")
+	return accepted
