{
  "schema_version": "1.0.0",
  "design_status": "partially_implemented_prototype_unplaytested",
  "date": "2026-10-08",
  "authority": {
    "normative_rules": "docs/PLAYER_EQUIPMENT_GUIDELINES.md",
    "numeric_values": "this file",
    "research": "docs/research/EQUIPMENT_BALANCE_RESEARCH.md",
    "formula_strings_are_documentation_not_executable_code": true
  },
  "controls": {
    "voluntary_movement": "swipe_dash_only",
    "primary": "immediate_first_tap",
    "followup": "second_nearby_tap",
    "double_tap_window_s": 0.28,
    "double_tap_distance_virtual_px_strictly_less_than": 90,
    "aim_origin": "last_completed_swipe_release_screen_position",
    "initial_aim_origin": "viewport_center",
    "zero_direction": "retain_last_facing",
    "dash_buffer_capacity": 1,
    "auto_aim": false,
    "act_specific_controller": false
  },
  "baseline": {
    "max_health": 100,
    "primary_damage": 20,
    "primary_range_world_units": 2,
    "primary_cooldown_s": 0.3,
    "primary_cone_min_dot": 0.05,
    "followup_damage": 42,
    "followup_range_world_units": 3.1,
    "followup_cooldown_s": 0.45,
    "followup_cone_min_dot": 0.5,
    "shell_capacity": 2,
    "shell_reload_s": 1.15,
    "primary_hit_reload_credit_s": 0.45,
    "dash_speed_world_units_per_s": 15,
    "dash_distance_world_units": 2.7,
    "dash_cooldown_s": 0.34,
    "dash_invulnerability_s": 0.12,
    "hurt_invulnerability_s": 0.8,
    "armour_multiplier": 1
  },
  "modifier_contract": {
    "combine": "add_fractional_deltas_then_clamp_once_per_stage",
    "gear_stage": "clamp(1 + sum(weapon_and_clothing_deltas), gear_min, gear_max)",
    "total_stage": "clamp(gear_multiplier + sum(eligible_conditional_powerup_and_action_scoped_deltas), total_min, total_max)",
    "damage_received": "raw_damage / armour_multiplier",
    "effective_health": "max_health * armour_multiplier",
    "dash_duration_s": "effective_dash_distance / effective_dash_speed",
    "attack_cooldown_s": "baseline_action_cooldown_s / attack_speed_multiplier",
    "act_number_enters_equation": false,
    "negative_dash_distance_modifiers_allowed": false,
    "rounding": "retain_float_values; round_only_for_display",
    "followup_range_absolute_max_world_units": 3.8,
    "same_ability_multiple_sources": "one_instance_highest_bonus_no_added_stacks",
    "reload_extra_credit_policy": "use_highest_eligible_extra_credit_not_sum",
    "reload_total_credit_cap_per_action_s": 0.65,
    "scoped_modifiers": "include only deltas eligible for the resolved action or target before the single total-stage clamp",
    "primary_only_cadence_planning_margin_s": 0.02
  },
  "stats": {
    "damage": {
      "gear_min": 0.75,
      "gear_max": 1.3,
      "total_min": 0.75,
      "total_max": 1.75,
      "budget_step": 0.05,
      "budget_weight": 1
    },
    "attack_speed": {
      "gear_min": 0.7,
      "gear_max": 1.2,
      "total_min": 0.7,
      "total_max": 1.35,
      "budget_step": 0.05,
      "budget_weight": 1.5
    },
    "attack_range": {
      "gear_min": 0.85,
      "gear_max": 1.15,
      "total_min": 0.85,
      "total_max": 1.3,
      "budget_step": 0.05,
      "budget_weight": 1.5
    },
    "dash_speed": {
      "gear_min": 0.85,
      "gear_max": 1.2,
      "total_min": 0.85,
      "total_max": 1.35,
      "budget_step": 0.05,
      "budget_weight": 1
    },
    "dash_distance": {
      "gear_min": 1,
      "gear_max": 1.15,
      "total_min": 1,
      "total_max": 1.35,
      "budget_step": 0.05,
      "budget_weight": 1.5
    },
    "max_health": {
      "gear_min": 0.8,
      "gear_max": 1.2,
      "total_min": 0.8,
      "total_max": 1.3,
      "budget_step": 0.1,
      "budget_weight": 1
    },
    "armour": {
      "gear_min": 1,
      "gear_max": 1.35,
      "total_min": 1,
      "total_max": 1.5,
      "budget_step": 0.1,
      "budget_weight": 1.5
    }
  },
  "budgets": {
    "clothing_net_points_max": 3,
    "perk_points": 2,
    "drawback_credit_fraction": 0.5,
    "drawback_credit_points_max": 1,
    "nonzero_stats_without_perk_max": 2,
    "nonzero_stats_with_perk_max": 2,
    "positive_static_stats_with_perk_max": 1,
    "formula": "sum(positive_delta / step * weight) + perk_points - min(1, 0.5 * sum(abs(negative_delta) / step * weight))",
    "same_budget_all_acts": true,
    "rarity_adds_power_budget": false,
    "weapon_neutral_primary_dps_ratio_min": 0.8,
    "weapon_neutral_primary_dps_ratio_max": 1.05,
    "range_has_separate_cost": true
  },
  "loadout_gates": {
    "gear_primary_dps_proxy_ratio_max": 1.35,
    "conditional_primary_dps_proxy_ratio_max": 1.6,
    "temporary_primary_dps_proxy_ratio_max": 1.85,
    "gear_effective_health_ratio_max": 1.4,
    "total_effective_health_ratio_max": 1.6,
    "primary_per_hit_damage_ratio_max": 1.75,
    "evaluate_all_conditional_peaks_not_expected_uptime_only": true,
    "dps_proxy": "damage_multiplier * attack_speed_multiplier; upper bound ignores gesture recognition ammo and misses",
    "geometry_min_primary_range_world_units": 1.7,
    "geometry_min_dash_distance_world_units": 2.7,
    "max_active_perks": 3,
    "max_active_powerup_groups": 2
  },
  "lifecycle": {
    "clothing_swap": "paused_loadout_menu_at_encounter_boundary",
    "weapon_swap": "contact_replaces_weapon_when_current_action_finishes",
    "one_weapon_defines": "both_primary_and_followup_profiles; no_weapon_hotbar",
    "swap_health": "min(old_current_health, new_max_health)",
    "weapon_swap_ammo": "preserve_current_shells",
    "weapon_swap_reload": "preserve_elapsed_reload_time",
    "cooldown_swap": "preserve_outstanding_deadline_never_shorten",
    "buff_pause": "freeze_active_simulation_timers",
    "checkpoint": "restore_coherent_loadout_health_ammo_buffs_rng_and_loot_snapshot",
    "between_acts": "carry_equipped_loadout_clear_temporary_effects",
    "neutral_loadout_available_at_checkpoints": true,
    "death": "restore_checkpoint_not_accrue_permanent_stats",
    "weapon_swap_action_end": "end_of_resolved_dash_or_attack_phase; not_cooldown_expiry"
  },
  "effect_event_order": [
    "gesture_recognized",
    "validate_action",
    "snapshot_static_and_active_stats",
    "snapshot_pre_action_health_and_target_states",
    "reserve_ammo_charges_and_cooldown_deadlines",
    "compute_action_and_target_bonuses",
    "resolve_direct_hits",
    "advance_combo_and_apply_once_per_action_credits",
    "resolve_future_eligible_effects_without_recursion",
    "finalize_expiry_and_state_commits"
  ],
